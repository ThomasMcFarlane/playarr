<Page
    x:Class="Playarr.Xbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        This is a native UWP library surface. XAML's built-in focus system
        owns gamepad traversal; GridView, ListView, and ScrollViewer own real
        scrolling. The Folders mode receives opaque roots and relative paths
        only, then opens playable files in the native PlayerPage.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="24"
            Margin="48,32,48,20"
            VerticalAlignment="Center">
            <TextBlock Text="Playarr" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:Name="HomeNavButton" Content="Home" Click="HomeNavButton_Click" />
            <Button x:Name="LibraryNavButton" Content="Library" IsEnabled="False" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="48,0,48,12"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="KindTabsPanel" Orientation="Horizontal" Spacing="12" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24" Margin="48,0,48,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="CatalogViewButton" Content="Library" Click="CatalogViewButton_Click" />
                <Button
                    x:Name="FoldersViewButton"
                    Content="Folders"
                    Click="FoldersViewButton_Click"
                    IsEnabled="False" />
            </StackPanel>

            <StackPanel x:Name="SortPanel" Orientation="Horizontal" Spacing="12">
                <Button x:Name="SortRecentButton" Content="Recently added" Click="SortRecentButton_Click" />
                <Button x:Name="SortTitleButton" Content="Title" Click="SortTitleButton_Click" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" Margin="48,0,48,48">
            <Grid x:Name="CatalogPanel">
                <GridView
                    x:Name="WorksGridView"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="WorksGridView_ItemClick" />
            </Grid>

            <Grid x:Name="FolderPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FolderRootsPanel" Orientation="Horizontal" Spacing="12" />
                </ScrollViewer>

                <TextBlock
                    x:Name="FolderWarningsText"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Visibility="Collapsed" />

                <ScrollViewer
                    Grid.Row="2"
                    Margin="0,12,0,12"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FolderBreadcrumbsPanel" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>

                <Grid Grid.Row="3">
                    <TextBlock
                        x:Name="FolderStatusText"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed" />
                    <ListView
                        x:Name="FolderEntriesListView"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="FolderEntriesListView_ItemClick" />
                </Grid>

                <Button
                    x:Name="LoadMoreFoldersButton"
                    Grid.Row="4"
                    Content="Load more"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    Click="LoadMoreFoldersButton_Click"
                    Visibility="Collapsed" />
            </Grid>

            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="64"
                Height="64"
                Visibility="Collapsed"
                Canvas.ZIndex="2" />

            <StackPanel
                x:Name="ErrorPanel"
                Spacing="12"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Canvas.ZIndex="3">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />
                <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
