<Page
    x:Class="Playarr.Xbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's pattern, see LibraryPage.xaml.cs's
        type-level remarks. Kind tabs are built in code (server-defined,
        variable count, plus an "All" tab this page adds itself); the two
        sort buttons are static since there are only ever two. Grid tiles are
        built in code via CatalogTileFactory, same as HomePage's row, see
        that shared factory's remarks on why WorksGridView uses
        Items.Add(...) rather than ItemsSource + a bound ItemTemplate.
    -->
    <!--
        Web TV library page (1920x1080): Back and title at the shell content edge with the "N TITLES" subtitle, the
        focused title's details on the left, and a 3-column grid of 328x184 landscape cards from x=783.
    -->
    <Grid>
        <Button
            x:Name="BackButton"
            Width="50"
            Height="50"
            CornerRadius="25"
            Margin="154,56,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="{StaticResource PlayarrLineStrong}"
            BorderThickness="1"
            Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
        </Button>
        <StackPanel Margin="228,57,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource PlayarrPageTitle}" />
            <TextBlock
                x:Name="CountText"
                FontSize="11"
                FontWeight="Bold"
                CharacterSpacing="120"
                Foreground="{StaticResource PlayarrBrandInk}"
                Margin="0,6,0,0" />
        </StackPanel>

        <!-- Focused title, as the web library's left detail column. -->
        <StackPanel
            x:Name="FocusPanel"
            Width="380"
            Margin="154,258,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="0">
            <TextBlock
                x:Name="FocusEyebrow"
                FontSize="12"
                FontWeight="Bold"
                CharacterSpacing="120"
                Foreground="{StaticResource PlayarrBrandInk}" />
            <TextBlock
                x:Name="FocusTitle"
                FontSize="64"
                FontWeight="SemiBold"
                CharacterSpacing="-30"
                LineHeight="64"
                TextWrapping="WrapWholeWords"
                MaxLines="3"
                Margin="0,22,0,0" />
            <TextBlock x:Name="FocusMeta" FontSize="14" Foreground="{StaticResource PlayarrInkSoft}" Margin="0,24,0,0" />
            <TextBlock
                x:Name="FocusOverview"
                FontSize="14"
                LineHeight="22"
                TextWrapping="WrapWholeWords"
                MaxLines="5"
                TextTrimming="WordEllipsis"
                Foreground="{StaticResource PlayarrInkSoft}"
                Margin="0,20,0,0" />
        </StackPanel>

        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="783,162,0,0"
            Width="40"
            Height="40" />

        <StackPanel
            x:Name="ErrorPanel"
            Spacing="12"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="783,162,0,0">
            <TextBlock x:Name="ErrorText" Style="{StaticResource PlayarrRailTitle}" />
            <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
        </StackPanel>

        <GridView
            x:Name="WorksGridView"
            Width="1080"
            Margin="783,0,0,0"
            Padding="0,162,0,48"
            HorizontalAlignment="Left"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ItemClick="WorksGridView_ItemClick" />
    </Grid>
</Page>
