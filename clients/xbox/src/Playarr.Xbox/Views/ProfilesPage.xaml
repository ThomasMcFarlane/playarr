<Page
    x:Class="Playarr.Xbox.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's pattern (see that file's type-level
        remarks): every dynamic value is a named element pushed to from
        code-behind's Render(); no {x:Bind}, no {Binding}. Profile tiles are
        built in code (ProfilesPage.xaml.cs) since they come from a
        runtime-loaded list, not static XAML.
    -->
    <Grid>
        <StackPanel
            x:Name="ContentPanel"
            MaxWidth="1100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="32">

            <TextBlock
                Text="Who's watching?"
                Style="{StaticResource TitleTextBlockStyle}"
                HorizontalAlignment="Center" />

            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                HorizontalAlignment="Center"
                Width="48"
                Height="48" />

            <StackPanel
                x:Name="ErrorPanel"
                Spacing="12"
                HorizontalAlignment="Center"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <Button
                    x:Name="RetryButton"
                    Content="Try again"
                    HorizontalAlignment="Center"
                    Click="RetryButton_Click" />
            </StackPanel>

            <ScrollViewer
                x:Name="ProfilesScrollViewer"
                HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollMode="Disabled">
                <StackPanel
                    x:Name="ProfilesPanel"
                    Orientation="Horizontal"
                    Spacing="24" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Page>
