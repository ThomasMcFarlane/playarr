<Page
    x:Class="Playarr.Xbox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        The real home/catalog screen, replacing the Screens-phase placeholder
        left behind by the foundation agent. Follows Views/LoginPage.xaml.cs's
        pattern, see HomePage.xaml.cs's type-level remarks. Tiles are built
        in code from HomeViewModel.RecentWorks via CatalogTileFactory, so
        RecentWorksList's items are added with Items.Add(...) in Render(),
        never an ItemTemplate/{Binding}.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top nav: shared shape, duplicated on LibraryPage; see that page's own copy. -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="24"
            Margin="48,32,48,24"
            VerticalAlignment="Center">
            <TextBlock Text="Playarr" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:Name="HomeNavButton" Content="Home" IsEnabled="False" />
            <Button x:Name="LibraryNavButton" Content="Library" Click="LibraryNavButton_Click" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="48,0,48,48" Spacing="16">
            <TextBlock Text="Recently added" Style="{StaticResource TitleTextBlockStyle}" />

            <ProgressRing
                x:Name="LoadingRing"
                IsActive="False"
                HorizontalAlignment="Left"
                Width="40"
                Height="40" />

            <StackPanel x:Name="ErrorPanel" Spacing="12" Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    Style="{StaticResource BodyTextBlockStyle}" />
                <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
            </StackPanel>

            <ListView
                x:Name="RecentWorksList"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="RecentWorksList_ItemClick"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                Height="340">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
