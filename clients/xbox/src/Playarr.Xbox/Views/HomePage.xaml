<Page
    x:Class="Playarr.Xbox.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        The real home/catalog screen, replacing the Screens-phase placeholder
        left behind by the foundation agent. Follows Views/LoginPage.xaml.cs's
        pattern, see HomePage.xaml.cs's type-level remarks. Tiles are built
        in code from HomeViewModel.Rails via CatalogTileFactory, so
        each rail ListView's items are added with Items.Add(...) in Render(),
        never an ItemTemplate/{Binding}.
    -->
    <!-- Web TV Home: rails start at the web's x (881 px) under the shell clock; one row per server rail. -->
    <Grid>
        <!-- Web Home hero: the focused title, very large and faint, behind the left of the rails. -->
        <TextBlock
            x:Name="HeroTitle"
            Width="700"
            Margin="337,282,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="150"
            FontWeight="Bold"
            LineHeight="135"
            CharacterSpacing="-20"
            TextWrapping="WrapWholeWords"
            MaxLines="2"
            Opacity="0.07"
            IsHitTestVisible="False" />

        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="881,415,0,0"
            Width="40"
            Height="40" />

        <StackPanel
            x:Name="ErrorPanel"
            Spacing="12"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="881,415,0,0">
            <TextBlock x:Name="ErrorText" Style="{StaticResource PlayarrRailTitle}" />
            <Button x:Name="RetryButton" Content="Try again" Click="RetryButton_Click" />
        </StackPanel>

        <ScrollViewer
            x:Name="RailsScroll"
            VerticalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Disabled">
            <StackPanel x:Name="RailsPanel" Margin="881,395,0,48" Spacing="38" />
        </ScrollViewer>
    </Grid>
</Page>
