<Page
    x:Class="Playarr.Xbox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's established pattern. The
        server-address entry/pairing panels below are a deliberate
        near-duplicate of LoginPage.xaml's own; see SettingsViewModel's
        remarks for why this screen composes LoginViewModel's logic rather
        than factoring a shared UserControl.
    -->
    <!--
        Web TV settings workspace (1920x1080): Back + "Preferences" with the open section as subtitle, the numbered
        section list on the left (x 154-634, 92 px rows) and the open section's controls on the right from x=774.
        Only sections this client implements are listed, keeping the web's numbers.
    -->
    <Grid>
        <Button
            x:Name="BackButton"
            Width="50"
            Height="50"
            CornerRadius="25"
            Margin="154,56,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="{StaticResource PlayarrLineStrong}"
            BorderThickness="1"
            Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
        </Button>
        <StackPanel Margin="228,57,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="Preferences" Style="{StaticResource PlayarrPageTitle}" />
            <TextBlock
                Text="SERVER CONNECTION"
                FontSize="11"
                FontWeight="Bold"
                CharacterSpacing="120"
                Foreground="{StaticResource PlayarrBrandInk}"
                Margin="0,6,0,0" />
        </StackPanel>

        <Button
            Width="480"
            Height="92"
            Margin="154,162,0,0"
            Padding="32,0,32,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Stretch"
            CornerRadius="0"
            BorderThickness="0"
            Background="{StaticResource PlayarrSurfaceSoft}">
            <Grid>
                <TextBlock Text="05" FontSize="10" FontWeight="Bold" Margin="0,-22,0,0" VerticalAlignment="Center" />
                <TextBlock Text="Server connection" FontSize="30" Margin="60,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="&#x2192;" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Button>

    <ScrollViewer Margin="774,200,0,0" Padding="0,0,106,48" VerticalScrollBarVisibility="Hidden">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Spacing="32">

            <StackPanel Spacing="8">
                <TextBlock Text="Current server" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />
                <TextBlock x:Name="CurrentServerText" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Change server address" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />

                <StackPanel x:Name="ServerPanel" Spacing="12">
                    <TextBox
                        x:Name="ServerAddressBox"
                        InputScope="Url"
                        PlaceholderText="http://your-server:8484" />
                    <TextBlock
                        x:Name="ServerErrorText"
                        Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="ConnectButton"
                        Content="Connect"
                        Click="ConnectButton_Click" />
                </StackPanel>

                <StackPanel x:Name="PairingPanel" Spacing="16" Visibility="Collapsed">
                    <ProgressRing x:Name="PairingProgressRing" IsActive="False" HorizontalAlignment="Left" />
                    <TextBlock x:Name="PairingStatusText" Style="{StaticResource BodyTextBlockStyle}" />

                    <StackPanel x:Name="DeviceCodePanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="On your phone or computer, go to:" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="VerificationUriText" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="and enter this code:" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="UserCodeText" FontSize="48" FontWeight="Bold" FontFamily="Consolas" />
                    </StackPanel>

                    <Button x:Name="CancelPairingButton" Content="Cancel" Click="CancelPairingButton_Click" />
                </StackPanel>

                <TextBlock
                    x:Name="ReconnectFailureText"
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="12">
                <Button x:Name="SignOutButton" Content="Sign out" Click="SignOutButton_Click" />
            </StackPanel>

            <TextBlock
                x:Name="AppVersionText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.6" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
