<Page
    x:Class="Playarr.Xbox.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's established pattern: every dynamic
        value is a plain x:Name'd element pushed to from code-behind's
        Render(). The one addition this page needs beyond LoginPage's shape,
        a dynamic list of result tiles, is built directly into
        ResultsGrid.Items in code-behind rather than through an
        ItemsSource/DataTemplate, so it stays consistent with "no x:Bind,
        no Binding anywhere in this project" (see SearchPage.xaml.cs).
    -->
    <!-- Web TV search (1920x1080): header, 595x80 pill field, helper text, empty state centred in the right half. -->
    <Grid>
        <Button
            x:Name="BackButton"
            Width="50"
            Height="50"
            CornerRadius="25"
            Margin="154,56,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="{StaticResource PlayarrLineStrong}"
            BorderThickness="1"
            Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
        </Button>
        <TextBlock Text="Search" Style="{StaticResource PlayarrPageTitle}" Margin="228,57,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />

        <Grid
            Width="595"
            Height="84"
            Margin="152,169,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            CornerRadius="42"
            Background="{StaticResource PlayarrSurfaceStrong}"
            BorderBrush="{StaticResource PlayarrLineStrong}"
            BorderThickness="1">
            <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="30,0,0,0" HorizontalAlignment="Left" Foreground="{StaticResource PlayarrInkSoft}" />
            <TextBox
                x:Name="QueryBox"
                Margin="56,0,24,0"
                VerticalAlignment="Center"
                FontSize="18"
                Background="Transparent"
                BorderThickness="0"
                PlaceholderText="Search your libraries and playlists"
                InputScope="Search"
                TextChanged="QueryBox_TextChanged"
                KeyUp="QueryBox_KeyUp" />
        </Grid>
        <TextBlock
            Text="Find any available movie, series, artist or playlist."
            Width="270"
            Margin="153,302,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="13.5"
            LineHeight="21"
            TextWrapping="WrapWholeWords"
            Foreground="{StaticResource PlayarrInkSoft}" />
        <ProgressRing x:Name="SearchingRing" IsActive="False" Width="32" Height="32" Margin="783,162,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock
            x:Name="ErrorText"
            Margin="783,162,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource PlayarrRailTitle}"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="EmptyStatePanel"
            Orientation="Horizontal"
            Spacing="42"
            Margin="1163,313,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
            <Border Width="131" Height="131" CornerRadius="65.5" BorderBrush="{StaticResource PlayarrLineStrong}" BorderThickness="1" Background="{StaticResource PlayarrSurface}">
                <FontIcon Glyph="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource PlayarrBrand}" />
            </Border>
            <TextBlock x:Name="EmptyStateText" Text="Start typing to search." FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <GridView
            x:Name="ResultsGrid"
            Width="1080"
            Margin="783,0,0,0"
            Padding="0,162,0,48"
            HorizontalAlignment="Left"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ItemClick="ResultsGrid_ItemClick" />
    </Grid>
</Page>
