<Page
    x:Class="Playarr.Xbox.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Playarr.Xbox.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Follows Views/LoginPage.xaml.cs's established pattern: every dynamic
        value is a plain x:Name'd element pushed to from code-behind's
        Render(). The one addition this page needs beyond LoginPage's shape,
        a dynamic list of result tiles, is built directly into
        ResultsGrid.Items in code-behind rather than through an
        ItemsSource/DataTemplate, so it stays consistent with "no x:Bind,
        no Binding anywhere in this project" (see SearchPage.xaml.cs).
    -->
    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Search"
            Style="{StaticResource TitleTextBlockStyle}"
            Margin="0,0,0,24" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBox
                x:Name="QueryBox"
                Width="480"
                PlaceholderText="Search movies, series…"
                InputScope="Search"
                KeyUp="QueryBox_KeyUp" />
            <Button x:Name="SearchButton" Content="Search" Click="SearchButton_Click" />
            <ProgressRing x:Name="SearchingRing" IsActive="False" Width="32" Height="32" />
        </StackPanel>

        <TextBlock
            x:Name="ErrorText"
            Grid.Row="2"
            Margin="0,12,0,0"
            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
            Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,24,0,0">
            <TextBlock
                x:Name="EmptyStateText"
                Text="No results yet — try a search above."
                Style="{StaticResource BodyTextBlockStyle}"
                Opacity="0.7"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

            <GridView
                x:Name="ResultsGrid"
                IsItemClickEnabled="True"
                SelectionMode="None"
                ItemClick="ResultsGrid_ItemClick" />
        </Grid>
    </Grid>
</Page>
