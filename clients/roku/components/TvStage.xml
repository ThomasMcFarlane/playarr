<?xml version="1.0" encoding="utf-8" ?>
<!--
  TvStage: reusable "stage" composition matching tv-web's detail/home hero
  layout (.tv-detail / .tv-key-art / .tv-title-panel / .tv-rail-panel in
  clients/tv-web/web/src/styles/global.css). Later pages compose on top of
  this by setting stageTitle/stageKicker/stageMeta/keyArtUri, inserting their
  own rail/grid content under `contentTarget`, then calling show().

  All positions/sizes below are fixed 1920x1080 px values evaluated from the
  source clamp()/vw/vh CSS formulas (Roku's canvas is fixed at fhd - see
  manifest ui_resolutions=fhd). Each block has a `from:` comment pointing at
  the CSS rule and the evaluated formula.

  CSS -> SceneGraph substitutions made here (see also TvStage.brs):
    - CSS `filter: grayscale()/contrast()/brightness()` + opacity + right
      mask on `.tv-key-art img` is applied **server-side** via
      `GET /api/v1/artwork/work/{id}/{kind}?style=stage` (see
      playarr-artwork::ArtworkStyle::Stage). The Poster loads that PNG;
      no client pixel filter exists on SceneGraph.
    - CSS `linear-gradient()` scrims (`.tv-key-art::after`, `.tv-stage-wash`)
      still have no native equivalent: stacked semi-transparent `Rectangle`
      nodes approximate left/top/bottom/right wash over the stage surface.
    - The CSS entrance easing `cubic-bezier(0.16, 1, 0.3, 1)` (strong
      deceleration) isn't expressible on SceneGraph's `Animation` node, which
      only accepts a fixed keyword set (linear, in/out/inOut Quad, Cubic,
      Quart, Quint, Sine, Expo, Circ, Back, Bounce). "outCubic" is used below
      as the closest built-in match (fast start, gentle finish). If a given
      Roku OS floor rejects "outCubic", fall back to "linear".
-->
<component name="TvStage" extends="Group">
  <interface>
    <!-- Background art image (poster/backdrop) for the key-art layer. -->
    <field id="keyArtUri" type="string" onChange="onKeyArtUriChange" />
    <!-- Optional HTTP headers (Bearer) for authenticated artwork proxy loads. -->
    <field id="keyArtHeaders" type="assocarray" />
    <!-- from: .tv-provider / .tv-detail-kicker text content -->
    <field id="stageKicker" type="string" onChange="onStageKickerChange" />
    <!-- from: .tv-title-panel h1 text content -->
    <field id="stageTitle" type="string" onChange="onStageTitleChange" />
    <!-- from: .tv-title-meta text content (kind / year / genres line) -->
    <field id="stageMeta" type="string" onChange="onStageMetaChange" />
    <!-- from: .tv-title-panel synopsis / overview under the meta line -->
    <field id="stageOverview" type="string" onChange="onStageOverviewChange" />
    <!--
      Output field: the empty content-panel Group other scenes should
      findNode()/append their own rail or grid content into. Treat this as
      read-only - it is populated once in init() and should not be
      reassigned by callers.
    -->
    <field id="contentTarget" type="node" />
    <!-- Runs the staggered fade+translate entrance. Call after populating
         stageTitle/stageKicker/stageMeta and contentTarget's children.
         Named playEntrance (not "show") to rule out any collision with a
         built-in roSGNode member of that name: "Member function not
         found" was observed on-device calling `.show()` despite the
         interface/backing sub both looking correct; renaming is the
         cheapest way to test that theory without deeper platform digging. -->
    <function name="playEntrance" />
    <!-- Instant full-opacity reveal at settled layout (re-entry / recovery). -->
    <function name="revealStage" />
  </interface>
  <children>
    <!--
      Key-art layer.
      from: .tv-key-art { position:absolute; inset:0 } and
      .tv-key-art img { width:52%; height:106%; object-fit:cover;
      object-position:center 20%; transform:scale(1.04) } evaluated at
      1920x1080:
        width  = 52%  of 1920 = 998px
        height = 106% of 1080 = 1145px
        top offset approximates object-position's vertical bias: -(1145-1080)/2 = -33px
      loadDisplayMode scaleToZoom (crop-to-fill, preserving aspect ratio) is
      Roku's match for object-fit:cover, NOT scaleToFill (stretch-to-fill,
      distorting it despite the deceptively similar name), confirmed live
      elsewhere this session (PosterCard.xml's own poster Poster) that
      scaleToFill visibly warps photographic art.
    -->
    <Group id="keyArtLayer" opacity="0">
      <!-- Key-art Poster loads GET /api/v1/artwork/...&style=stage (server
           greyscale + opacity + right fade). No client-side filter wash on
           the bitmap itself - - that used to fight a full-colour source. -->
      <Poster id="keyArt" translation="[-20,-22.9]" width="1038" height="1191" loadDisplayMode="scaleToZoom" />
      <!-- Web masks the cropped image with linear-gradient(90deg, #000 72%,
           transparent 100%). The server bakes that fade into the source
           bitmap, but scaleToZoom crops the sides off, so the fade never
           reaches the stage and the art ended in a hard edge at x=998.
           Re-apply it here: a surface-coloured ramp over the last 28%
           (x=718..998, from: 72% of 998). -->
      <Poster id="keyArtFade" translation="[727,-22.9]" width="291" height="1191" uri="pkg:/images/stage-key-art-fade.png" loadDisplayMode="scaleToFill" />
      <!-- Soft stage wash only (left + vertical vignette). Pixel math for
           greyscale/contrast/brightness/opacity is baked server-side. -->
      <!-- Web gradients as stretched alpha ramps tinted with the page surface colour (ThemeSetRole in TvStage.brs):
           .tv-key-art::after = 90deg surface -> transparent over 22 % (422 px); 0deg surface -> transparent over the bottom 22 %
           (238 px) and surface at the top from 82 % (the top 194 px); .tv-stage-wash = 90deg surface 94 % over 31 % (595 px) and
           270deg surface 50 % over 34 % (653 px). -->
      <StageScrims id="scrimLayer" />
    </Group>

    <!--
      Title panel.
      from: .tv-title-panel { top:31%; left:clamp(44px,7.5vw,150px); width:min(27vw,520px) }
      evaluated at 1920x1080:
        top   = 31% of 1080 = 334.8 -> 335px
        left  = 7.5vw of 1920 = 144px (within the 44-150px clamp bounds)
        width = 27vw of 1920 = 518.4 -> 518px (under the 520px cap)
    -->
    <Group id="titlePanel" translation="[153.6,259.2]" opacity="0">
      <!-- from: .tv-provider/.tv-detail-kicker font-size clamp(0.58rem,0.64vw,0.78rem)
           evaluated at 1920px: 0.64vw = 12.288px -> 12px. Color: theme accent (#cf3157). -->
      <TrackedText id="stageKickerLabel" translation="[0,0]" />
      <!-- from: .tv-title-panel h1 font-size clamp(2.7rem,4.5vw,6.4rem) evaluated at
           1920px: 4.5vw = 86.4px -> 86px. Color: theme ink.
           Font child removed (platform bug - see Theme.brs); width/height
           divided by scale factor to preserve the pre-scale wrap box.
           Height corrected: 82px pre-scale (=221px visual) only fit ~1
           truncated line despite maxLines="3": Roku truncates-with-
           ellipsis to whatever fits the declared box height regardless of
           maxLines, it doesn't grow the box to fit more lines. Using the
           same font-size-to-line-height ratio as Theme.brs's type scale
           (~1.42x, e.g. display 50/71) for 3 real lines: 86px * 1.42 = 122px
           visual line height * 3 lines = 366px visual / 2.69 scale = 136px. -->
      <TrackedText id="stageTitleLabel" translation="[0,29.3]" />
      <!-- from: .tv-title-meta font-size clamp(0.68rem,0.78vw,0.96rem) evaluated at
           1920px: 0.78vw = 14.976px -> 15px. Color: theme inkSoft. -->
      <Label id="stageMetaLabel" translation="[0,133.5]" width="1400" height="40" scale="[0.33,0.33]" color="0x887A82FF" />
      <!-- Synopsis under meta (tv-web .tv-title-panel body copy). -->
      <TrackedText id="stageOverviewLabel" translation="[0,171]" />
    </Group>

    <!--
      Content panel: empty region other scenes populate via `contentTarget`.
      Positioned to match tv-web's right-hand rail/content region.
      from: .tv-rail-panel { top:24%; right:3.8%; width:45%; min-height:39% }
      evaluated at 1920x1080:
        top    = 24% of 1080 = 259.2 -> 259px
        right  = 3.8% of 1920 = 72.96 -> 73px
        width  = 45% of 1920 = 864px
        left   = 1920 - width - right = 1920 - 864 - 73 = 983px
        height = 39% of 1080 = 421.2 -> 421px (min-height, content may exceed it)
    -->
    <Group id="contentPanel" translation="[881.6,422.9]" opacity="0" />

    <!--
      Entrance animation: fades+translates keyArtLayer, titlePanel, and
      contentPanel in with tv-web's staggered delays baked into each
      interpolator's `key` array as a "hold at start value" segment (a single
      Animation node applies one overall duration/state to every child
      interpolator, so per-target delay has to be encoded this way rather
      than as a separate `delay` field per target).

      from: .tv-key-art-in (760ms, starts immediately)
            .tv-copy-in    (620ms, 90ms delay)  - title panel
            .tv-rail-in    (700ms, 120-180ms delay; 150ms used here) - content panel
      Total animation window: 900ms (0.9s), matching the latest-finishing
      target (title panel: 90ms + 620ms = 710ms; content panel: 150ms + 700ms
      = 850ms; both comfortably inside 900ms).
    -->
    <Timer id="keyArtRetryTimer" duration="2" repeat="false" />
    <Animation id="entranceAnimation" duration="0.9" easeFunction="outCubic">
      <!-- key-art: fade 0->1 across the first 760/900 = 0.844 of the timeline -->
      <FloatFieldInterpolator id="keyArtOpacityInterp" fieldToInterp="keyArtLayer.opacity"
        key="[0.0, 0.844]" keyValue="[0.0, 1.0]" />
      <Vector2DFieldInterpolator id="keyArtTranslateInterp" fieldToInterp="keyArtLayer.translation"
        key="[0.0, 0.844]" keyValue="[[15.0,0.0],[0.0,0.0]]" />

      <!-- title panel: hold hidden until 90/900 = 0.10, then fade+slide in
           over 620ms, finishing at (90+620)/900 = 0.789 -->
      <FloatFieldInterpolator id="titleOpacityInterp" fieldToInterp="titlePanel.opacity"
        key="[0.0, 0.10, 0.789]" keyValue="[0.0, 0.0, 1.0]" />
      <Vector2DFieldInterpolator id="titleTranslateInterp" fieldToInterp="titlePanel.translation"
        key="[0.0, 0.10, 0.789]" keyValue="[[119.6,259.2],[119.6,259.2],[153.6,259.2]]" />

      <!-- content panel: hold hidden until 150/900 = 0.167, then fade+slide in
           over 700ms, finishing at (150+700)/900 = 0.944 -->
      <FloatFieldInterpolator id="contentOpacityInterp" fieldToInterp="contentPanel.opacity"
        key="[0.0, 0.167, 0.944]" keyValue="[0.0, 0.0, 1.0]" />
      <Vector2DFieldInterpolator id="contentTranslateInterp" fieldToInterp="contentPanel.translation"
        key="[0.0, 0.167, 0.944]" keyValue="[[941.6,422.9],[941.6,422.9],[881.6,422.9]]" />
    </Animation>
  </children>
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/TvStage.brs" />
</component>
