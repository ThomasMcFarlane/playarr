<?xml version="1.0" encoding="utf-8" ?>
<!--
  Web Profiles.tsx profile-avatar-button: circular gradient/mascot, name +
  status under it. Focus grows from the circle centre (not top-left) so the
  row of circles stays on one baseline.
-->
<component name="ProfileAvatar" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContentChanged" />
    <field id="focusPercent" type="float" onChange="onFocusChanged" />
    <field id="activeRailFactor" type="float" value="1" onChange="onFocusChanged" />
  </interface>
  <children>
    <!--
      Item box is 280×360 (MainScene buildProfileAvatarContent).
      Circle 240 centred horizontally with top pad so focus ring is not clipped.
      scaleRotateCenter on circleGroup = circle centre so focus scale stays aligned.
    -->
    <Group id="circleGroup" translation="[20,16]" scaleRotateCenter="[120,120]">
      <!-- Ring: 16px pad around 240 circle → 272; centre on circle. -->
      <Poster id="focusRing" translation="[-16,-16]" width="272" height="272" uri="pkg:/images/avatar-ring.png" opacity="0" loadDisplayMode="scaleToFit" />
      <Poster id="avatarImage" translation="[0,0]" width="240" height="240" loadDisplayMode="scaleToFit" />
      <Label id="initial" translation="[0,0]" width="240" height="240" horizAlign="center" vertAlign="center" scale="[2.2,2.2]" scaleRotateCenter="[120,120]" color="0xFFFFFFFF" visible="false" />
    </Group>
    <Label id="name" translation="[0,268]" width="280" height="34" horizAlign="center" numLines="1" scale="[0.55,0.55]" scaleRotateCenter="[140,17]" color="0xF4F0F1FF" />
    <Label id="status" translation="[0,300]" width="280" height="28" horizAlign="center" numLines="1" scale="[0.40,0.40]" scaleRotateCenter="[140,14]" color="0x887A82FF" />
  </children>
  <script type="text/brightscript" uri="pkg:/source/Fonts.brs" />
  <script type="text/brightscript" uri="pkg:/components/ProfileAvatar.brs" />
</component>
