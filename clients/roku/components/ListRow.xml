<?xml version="1.0" encoding="utf-8" ?>
<!--
  ListRow: generic MarkupList/MarkupGrid item for feature pages. The content
  node's `rowKind` field picks the look:
    heading  section/day heading (not selectable; the owner skips it)
    item     two-line row with a meta line, state dot and optional poster
    option   filter option with a check mark (`checked`)
    action   plain text action row (for example "Clear filters")
  `rowW` / `rowH` carry the item size (defaults 1000 x 88).
-->
<component name="ListRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onRowContent" />
    <field id="focusPercent" type="float" onChange="onRowFocus" />
  </interface>
  <children>
    <Rectangle id="rowBg" width="1000" height="80" color="0x1B181BFF" />
    <Rectangle id="rowFocus" width="1000" height="80" color="0xCF3157FF" visible="false" />
    <Poster id="rowPoster" translation="[12,6]" width="52" height="68" loadDisplayMode="scaleToZoom" visible="false" />
    <Rectangle id="rowDot" translation="[0,0]" width="8" height="80" color="0x7FC09DFF" visible="false" />
    <Label id="rowTitle" translation="[24,8]" width="1500" height="40" scale="[0.6,0.6]" color="0xF4F0F1FF" ellipsisText="..." maxLines="1" />
    <Label id="rowSubtitle" translation="[24,36]" width="1700" height="30" scale="[0.46,0.46]" color="0xC5B8BDFF" ellipsisText="..." maxLines="1" />
    <Label id="rowMeta" translation="[24,58]" width="1700" height="30" scale="[0.4,0.4]" color="0x887A82FF" ellipsisText="..." maxLines="1" />
    <Label id="rowHeading" translation="[8,26]" width="1700" height="40" scale="[0.5,0.5]" color="0xCF3157FF" visible="false" />
    <Label id="rowCheck" translation="[24,12]" width="120" height="50" scale="[0.6,0.6]" color="0xF4F0F1FF" visible="false" />
    <Label id="rowOption" translation="[90,12]" width="900" height="50" scale="[0.6,0.6]" color="0xF4F0F1FF" visible="false" ellipsisText="..." maxLines="1" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/ListRow.brs" />
</component>
