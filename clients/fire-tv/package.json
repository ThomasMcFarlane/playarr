{
  "name": "playarr-fire-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Playarr for Fire TV -- a React Native app targeting Amazon's Vega OS (Linux-based, New Architecture/Fabric, Hermes-only). Standalone npm project, deliberately outside the clients/tv-web pnpm workspace -- see README.md and docs/architecture/clients/fire-tv.md for why.",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0 <21.0.0"
  },
  "scripts": {
    "start": "react-native start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "gate": "node --test scripts/*.test.mjs",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:release": "react-native build-vega --build-type Release",
    "manifest:validate": "vega exec vpt validate ./manifest.toml",
    "vpkg:info": "vega exec vpt info build/armv7-release/playarr_armv7.vpkg --json",
    "vd:start": "vega virtual-device start --no-gl-accel --display-res=1920,1080",
    "run:vd": "vega run-app build/x86_64-release/playarr_x86_64.vpkg com.streamarr.firetv.main -d VirtualDevice",
    "vd:stop": "vega virtual-device stop",
    "device:install": "vega device install-app --packagePath build/armv7-release/playarr_armv7.vpkg",
    "device:launch": "vega device launch-app --appName com.streamarr.firetv.main",
    "device:logs": "vega device start-log-stream"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.0",

    "@amazon-devices/react-native-kepler": "~2.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.2.11",
    "@amazon-devices/kepler-media-controls": "~1.0.0",
    "@amazon-devices/react-native-async-storage__async-storage": "~2.1.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@amazon-devices/keplerscript-netmgr-lib": "~2.0.2",
    "@amazon-devices/kepler-file-system": "0.0.5",
    "@amazon-devices/react-native-device-info": "~2.1.0",
    "@amazon-devices/react-navigation__native": "~7.0.0",
    "@amazon-devices/react-navigation__stack": "~7.0.0",
    "@amazon-devices/react-navigation__core": "~7.0.0",
    "@amazon-devices/react-navigation__routers": "~7.0.0",
    "@amazon-devices/react-navigation__elements": "~7.0.0",
    "@amazon-devices/shopify__flash-list": "~2.0.0",
    "@amazon-devices/react-native-svg": "~2.0.0",
    "@amazon-devices/react-native-screens": "~2.0.0",
    "@amazon-devices/react-native-gesture-handler": "~2.0.0",
    "@amazon-devices/react-native-safe-area-context": "~2.0.0",
    "@amazon-devices/react-linear-gradient": "~2.0.0",

    "openapi-fetch": "^0.13.4",
    "qrcode": "^1.5.4",
    "react-native-url-polyfill": "^4.0.0",
    "base-64": "1.0.0",
    "fastestsmallesttextencoderdecoder": "1.0.22",
    "xmldom": "~0.6.0",
    "@xmldom/xmldom": "0.8.15",
    "react-native-uuid": "^2.0.4",
    "@babel/runtime": "^7.24.0"
  },
  "devDependencies": {
    "typescript": "~4.9.5",
    "@react-native-community/cli": "11.3.2",
    "@react-native/metro-config": "^0.72.6",
    "metro-react-native-babel-preset": "^0.76.5",
    "@amazon-devices/kepler-cli-platform": "~0.22.0",

    "jest": "29.7.0",
    "react-test-renderer": "18.2.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.75",
    "@types/react-test-renderer": "^18.0.0",
    "@types/node": "^20.11.30",
    "@types/qrcode": "^1.5.6",
    "@types/xmldom": "~0.1.34",
    "@types/base-64": "~1.0.2",

    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "babel-jest": "^29.7.0"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Playarr",
    "targets": ["tv"],
    "os": ["vega"],
    "api": 0.1
  }
}
