# clients/fire-tv is deliberately a plain npm project, not a member of the
# clients/tv-web pnpm workspace -- see README.md and design doc §4.1 for the
# full reasoning (React Native's Metro/autolinking is fragile under pnpm's
# symlinked node_modules, Vega pins React/TypeScript versions the tv-web
# catalog doesn't share, and Amazon's own Vega samples use npm + this exact
# setting). Keep package-lock.json committed; CI and local installs both run
# `npm ci` against it, never `npm install` against a moving target.

# Amazon's @amazon-devices packages declare peerDependencies against each
# other's own pre-release version ranges (see the version notes in
# package.json -- several only publish "9000000000"-style sentinel patch
# builds or timestamp-stamped canaries, not clean semver). npm's default
# (strict) peer resolution would refuse to install over the inevitable
# mismatches; legacy-peer-deps installs everything and lets the actually
# load-bearing conflicts surface as real tsc/Metro errors instead of an
# install-time wall. This mirrors Amazon's own sample apps' .npmrc.
legacy-peer-deps=true
