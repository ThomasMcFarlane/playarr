{
  "app": {
    // Empty on purpose: hvigor validates a declared signing config as complete material
    // (certificate, profile, keystore, algorithm) before it compiles anything, so a placeholder
    // entry breaks the unsigned CI build. The release build produces entry-default-unsigned.hap
    // and scripts/sign.sh signs it afterwards from environment variables; real signing material
    // never lives in the repo (see brief §10, risk R9). To sign from DevEco Studio locally, add a
    // signingConfigs entry and set "signingConfig" on the product in an uncommitted change.
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "compileSdkVersion": "5.1.0(18)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
