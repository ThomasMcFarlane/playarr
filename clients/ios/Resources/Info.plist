<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Playarr</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UIAppFonts</key>
	<array>
		<string>NunitoSans-wght-web.ttf</string>
		<string>JetBrainsMono-Variable.ttf</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- Self-hosted Playarr Server: user-entered http:// addresses (LAN, VPN or
		     WAN, including AVPlayer media loads) must connect. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Playarr connects to the Playarr Server you configure on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
		<!-- Per-application-id entry required alongside the generic
		     "_googlecast._tcp" above for on-device discovery on iOS 14+;
		     one alone silently finds zero devices. "00000000" is an
		     obviously-fake placeholder (a stand-in, like the one the
		     old App Store id constant used to be): keep this in sync
		     with PlayarrCastReceiverAppID below once a real receiver
		     Application ID is issued via the Google Cast SDK Developer
		     Console. -->
		<string>_00000000._googlecast._tcp</string>
	</array>
	<key>PlayarrCastReceiverAppID</key>
	<!-- Empty on purpose: AppDelegate guards on this being non-empty before
	     initializing GCKCastContext, so a placeholder empty string means
	     casting is inert, not crashing. Replace with the real Application
	     ID once one is issued, and update NSBonjourServices' per-app-id
	     entry above to match. -->
	<string></string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Keeps GCKCastContext/session callbacks (and the mini-controller)
		     alive while the app is backgrounded during a cast, per Google's
		     Cast iOS integration guidance; not solely for local audio
		     playback. -->
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
