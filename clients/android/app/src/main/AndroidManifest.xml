<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PlayarrDownloadService: Media3's own DownloadService promotes
         itself to a foreground service while any download is active, so it
         can keep running (and show real progress) while the app isn't in
         the foreground. These two permissions are required for that
         "dataSync" foreground service type from API 28 / API 34 onward
         respectively. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".PlayarrMobileApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Playarr"
        tools:targetApi="34">

        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_messaging_installation_id_enabled" android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="invite-approvals" />

        <!-- Playarr Cast: read by the Cast framework at CastContext init
             time. Must name a class with a public no-arg constructor (see
             cast/PlayarrCastOptionsProvider.kt and this module's matching
             proguard -keep rule); omitting or mistyping this makes casting
             silently unavailable rather than crash. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="io.playarr.mobile.cast.PlayarrCastOptionsProvider" />
        <service
            android:name=".InviteApprovalMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Disables WorkManager's default androidx.startup initializer:
             PlayarrMobileApp implements Configuration.Provider (a Hilt-
             aware WorkerFactory for KeepUntilSweepWorker's @HiltWorker
             constructor), which only takes effect if WorkManager's own
             automatic, non-Hilt-aware initialization is turned off here. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name=".download.PlayarrDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Playarr.Splash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|colorMode|layoutDirection|locale|fontScale|touchscreen|mcc|mnc"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
