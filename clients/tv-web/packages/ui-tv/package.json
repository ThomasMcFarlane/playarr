{
  "name": "@playarr-tv/ui-tv",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TV screen/component skeletons (Browse, Detail, Player placeholder) built on @playarr-tv/spatial-nav, consumed by the webOS, Tizen, and VIDAA-fallback app shells.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@playarr-tv/api-client": "workspace:*",
    "@playarr-tv/design-tokens": "workspace:*",
    "@playarr-tv/device-auth": "workspace:*",
    "@playarr-tv/domain": "workspace:*",
    "@playarr-tv/player-core": "workspace:*",
    "@playarr-tv/spatial-nav": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
