{
  "name": "@streamarr-tv/player-shaka",
  "version": "0.1.0",
  "private": true,
  "description": "Shaka Player adapter implementing PlaybackEngine, used by the web app, webOS, and the VIDAA fallback PWA (all modern-enough WebKit/Chromium for MSE + EME).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streamarr-tv/player-core": "workspace:*",
    "shaka-player": "^4.11.0"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
