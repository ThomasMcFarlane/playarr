{
  "name": "@streamarr-tv/player-avplay",
  "version": "0.1.0",
  "private": true,
  "description": "Production Samsung Tizen webapis.avplay adapter implementing Playarr's shared PlaybackEngine contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streamarr-tv/player-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
