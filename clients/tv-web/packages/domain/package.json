{
  "name": "@playarr-tv/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript domain types for the Playarr Server TV & web clients, mirroring playarr-model's domain types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "^2.1.8"
  }
}
