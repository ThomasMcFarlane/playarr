{
  "name": "@streamarr-tv/player-core",
  "version": "0.1.0",
  "private": true,
  "description": "PlaybackEngine TypeScript interface (load/play/pause/seek/getState + DRM config shape) implemented by player-shaka and player-avplay.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
