{
  "name": "streamarr-tv-web",
  "version": "0.1.0",
  "private": true,
  "description": "Streamarr TV & web client workspace: shared packages, per-platform TV app shells (webOS, Tizen, VIDAA fallback), and the standalone web app.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "dev:web": "pnpm --filter @streamarr-tv/web run dev",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
