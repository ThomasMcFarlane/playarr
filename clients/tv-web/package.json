{
  "name": "streamarr-tv-web",
  "version": "0.1.0",
  "private": true,
  "description": "Streamarr TV & web client workspace: shared packages, per-platform TV app shells (webOS, Tizen, VIDAA fallback), and the standalone web app.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "dev:web": "pnpm --filter @streamarr-tv/web run dev",
    "clean": "pnpm -r --if-present run clean"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:"
  }
}
