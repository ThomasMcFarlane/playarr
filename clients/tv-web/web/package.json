{
  "name": "@playarr-tv/web",
  "version": "0.1.0",
  "private": true,
  "description": "Playarr Server standalone web app: Vite + React + TypeScript. Home/Library/Player/Settings routes, Admin's real request-management UI, and a versioned service-worker-driven OTA self-update flow (see src/lib/appUpdate.ts).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-vidaa-store.mjs && node scripts/generate-build-manifest.mjs && vite",
    "build": "node scripts/sync-vidaa-store.mjs && node scripts/generate-build-manifest.mjs && tsc -p tsconfig.json --noEmit && vite build && node scripts/copy-cast-receiver.mjs",
    "build:debug-mirror": "node scripts/generate-build-manifest.mjs && tsc -p tsconfig.json --noEmit && vite build --mode debug-mirror",
    "build:server": "node scripts/generate-build-manifest.mjs && tsc -p tsconfig.json --noEmit && vite build --mode server && node scripts/rewrite-server-manifest.mjs",
    "deploy:cloudflare": "pnpm --filter @playarr-tv/web... run build && esbuild worker.js --bundle --format=esm --platform=browser --target=es2022 --external:cloudflare:sockets --outfile=dist-worker.mjs && node scripts/deploy-cloudflare-api.mjs",
    "lint": "vitest run src/lib/*Audit.test.ts src/lib/*Registry.test.ts src/lib/pageLayoutCss.test.ts",
    "test": "vitest run",
    "perf:nav": "node scripts/nav-perf.mjs",
    "smoke:nav": "node scripts/nav-smoke.mjs",
    "smoke:rails": "node scripts/rail-geometry-e2e.mjs",
    "test:playback-e2e": "node scripts/playback-e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "smoke:header": "node scripts/header-parity.mjs",
    "smoke:profile-chip": "node scripts/profile-chip-settle.mjs",
    "smoke:layout": "node scripts/layout-parity.mjs",
    "smoke:calendar-layout": "node scripts/calendar-layout.mjs",
    "smoke:calendar-nav": "node scripts/calendar-nav.mjs",
    "smoke:tablet-layout": "node scripts/tablet-layout.mjs",
    "smoke:tv-viewport": "node scripts/tv-viewport.mjs",
    "smoke:drawer-close": "node scripts/drawer-close.mjs",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o dist-storybook --disable-telemetry",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "smoke:storybook": "node scripts/storybook-smoke.mjs"
  },
  "dependencies": {
    "@playarr-tv/api-client": "workspace:*",
    "@playarr-tv/app-cast-receiver": "workspace:*",
    "@playarr-tv/cast-protocol": "workspace:*",
    "@playarr-tv/device-auth": "workspace:*",
    "@playarr-tv/domain": "workspace:*",
    "@playarr-tv/player-avplay": "workspace:*",
    "@playarr-tv/player-core": "workspace:*",
    "@playarr-tv/player-shaka": "workspace:*",
    "firebase": "12.15.0",
    "jpeg-js": "^0.4.4",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/chrome": "catalog:",
    "@types/chromecast-caf-sender": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "4.11.0",
    "esbuild": "0.21.5",
    "html-to-image": "1.11.13",
    "playwright-core": "^1.63.0",
    "storybook": "10.6.1",
    "storybook-addon-pseudo-states": "10.6.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^2.1.8"
  }
}
