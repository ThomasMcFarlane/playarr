{
  "name": "@streamarr-tv/web",
  "version": "0.1.0",
  "private": true,
  "description": "Streamarr standalone web app: Vite + React + TypeScript, with placeholder routing for Home/Library/Player/Settings/Admin (Admin hosts the future request-management UI).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streamarr-tv/api-client": "workspace:*",
    "@streamarr-tv/domain": "workspace:*",
    "@streamarr-tv/player-shaka": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
