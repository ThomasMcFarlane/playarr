{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "playarr-web",
  "main": "worker.js",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "CLIENT_DOWNLOADS",
      "bucket_name": "playarr-client-downloads"
    }
  ],
  "routes": [
    {
      "pattern": "playarr.app",
      "custom_domain": true
    }
  ]
}
