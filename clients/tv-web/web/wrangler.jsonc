{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "playarr-web",
  "main": "worker.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/cast",
      "/cast/*",
      "/clients",
      "/clients/*",
      "/downloads/*",
      "/legal/*",
      "/storybook",
      "/storybook/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LINK_SESSIONS",
        "class_name": "LinkSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LinkSession"]
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "routes": [
    {
      "pattern": "playarr.app",
      "custom_domain": true
    }
  ]
}
