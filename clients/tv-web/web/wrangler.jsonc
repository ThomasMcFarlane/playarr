{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "playarr-web",
  "compatibility_date": "2026-07-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "playarr.app",
      "custom_domain": true
    }
  ]
}
