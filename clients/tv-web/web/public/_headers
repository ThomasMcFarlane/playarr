# Cloudflare Workers static assets headers (deployed by scripts/deploy-cloudflare-api.mjs).
# Vite content-hashes everything under /assets, so those files never change: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry points name the hashed files, so they must be revalidated on every load.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/build-manifest.json
  Cache-Control: no-cache
