<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tizen TV web-application manifest (W3C widget config + Tizen namespace
  extensions). Tizen Studio's packaging tools (`tizen build-web` /
  `tizen package`) conventionally read this from `config.xml` at the
  project root. The package preparation step copies this checked-in source to
  `dist/config.xml` after every production build.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://playarr.tv/tizen/app"
        version="0.1.0"
        viewmodes="maximized">

  <tizen:application id="StrmarrTV1.Playarr"
                      package="StrmarrTV1"
                      required_version="7.0"/>

  <tizen:profile name="tv"/>

  <name>Playarr</name>
  <icon src="icon.png"/>
  <content src="index.html"/>

  <!-- The viewer chooses their own Playarr server, so API, artwork, manifest,
       segment, and subtitle origins cannot be known at build time. -->
  <access origin="*" subdomains="true"/>

  <feature name="http://tizen.org/feature/screen.size.all"/>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/network.get"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
  <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
  <tizen:setting screen-orientation="landscape"
                  context-menu="disable"
                  background-support="disable"
                  encryption="disable"
                  install-location="auto"
                  hwkey-event="enable"/>
</widget>
