{
  "name": "@streamarr-tv/app-tizen",
  "version": "0.1.0",
  "private": true,
  "description": "Samsung Tizen package of the complete Playarr web application with native AVPlay playback and TV remote integration.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/prepare-package.mjs",
    "test": "node --test scripts/*.test.mjs",
    "package:wgt": "pnpm --filter @streamarr-tv/app-tizen... run build && node scripts/package-wgt.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@streamarr-tv/player-avplay": "workspace:*",
    "@streamarr-tv/web": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
