{
  "name": "@streamarr-tv/app-webos",
  "version": "0.1.0",
  "private": true,
  "description": "The full Playarr web client packaged as an installable LG webOS TV application.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/prepare-package.mjs",
    "test": "node --test scripts/*.test.mjs src/*.test.mjs",
    "package:ipk": "pnpm --filter @streamarr-tv/app-webos... run build && ares-package dist -o out",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "simulator:install": "bash scripts/webos-sdk/install-simulator.sh",
    "simulator": "bash scripts/webos-sdk/launch-simulator.sh",
    "emulator:install": "bash scripts/webos-sdk/install-ose-emulator.sh",
    "emulator": "bash scripts/webos-sdk/launch-ose-emulator.sh"
  },
  "dependencies": {
    "@streamarr-tv/web": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
