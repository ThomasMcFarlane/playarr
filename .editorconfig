# EditorConfig helps maintain consistent coding styles across the many
# languages in this monorepo (Rust, TypeScript, Kotlin, Swift, YAML, etc).
# See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust: rustfmt's own defaults (4-space indent), enforced by `cargo fmt`.
[*.rs]
indent_size = 4

# Kotlin / Java / Gradle (Android clients).
[*.{kt,kts,java}]
indent_size = 4

[*.{gradle,gradle.kts}]
indent_size = 4

# Swift (iOS client).
[*.swift]
indent_size = 4

# C-family (native modules, if any).
[*.{c,h,cpp,hpp,m,mm}]
indent_size = 4

# Web / TS / JS (tv-web client).
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Makefiles and Justfile require literal tabs.
[{Makefile,Justfile,*.mk}]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
