{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadNodeSelector",
    "workloads",
    "regionalInstances"
  ],
  "properties": {
    "workloadNodeSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "imagePullPolicy",
          "replicas",
          "containerPort",
          "routes"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "imagePullPolicy": {
            "enum": [
              "Always",
              "IfNotPresent",
              "Never"
            ]
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "probeHost": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "workingDir": {
            "type": "string"
          },
          "podSecurityContext": {
            "type": "object"
          },
          "hostPathVolumes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "path",
                "type",
                "mounts"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "mounts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "mountPath"
                    ],
                    "properties": {
                      "mountPath": {
                        "type": "string"
                      },
                      "readOnly": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "host"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "hostRewrite": {
                  "type": "string"
                },
                "websocket": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "regionalInstances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "imagePullPolicy",
          "replicas",
          "nodeName",
          "secretName",
          "podSecurityContext",
          "thumbnailConcurrency",
          "resources",
          "persistence",
          "mediaPath",
          "routeHost"
        ],
        "properties": {
          "image": {
            "type": "string",
            "minLength": 1
          },
          "imagePullPolicy": {
            "enum": [
              "Always",
              "IfNotPresent",
              "Never"
            ]
          },
          "replicas": {
            "type": "integer",
            "minimum": 0
          },
          "nodeName": {
            "type": "string",
            "minLength": 1
          },
          "secretName": {
            "type": "string",
            "minLength": 1
          },
          "podSecurityContext": {
            "type": "object"
          },
          "thumbnailConcurrency": {
            "type": "integer",
            "minimum": 1
          },
          "peerInternalRoutes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}=[A-Za-z0-9.-]+@[A-Za-z0-9.-]+\\.svc\\.cluster\\.local:443$"
            }
          },
          "sourceInstanceUrls": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "dubarrApiKeySecret": {
            "type": "object",
            "required": ["name", "key"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 }
            }
          },
          "resources": {
            "type": "object"
          },
          "persistence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "create",
              "claimName",
              "volumeName",
              "storageClassName",
              "size"
            ],
            "properties": {
              "create": {
                "type": "boolean"
              },
              "claimName": {
                "type": "string",
                "minLength": 1
              },
              "volumeName": {
                "type": "string",
                "minLength": 1
              },
              "storageClassName": {
                "type": "string",
                "minLength": 1
              },
              "size": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "mediaPath": {
            "type": "string",
            "minLength": 1
          },
          "routeHost": {
            "type": "string",
            "minLength": 1
          },
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hostnames"
            ],
            "properties": {
              "hostnames": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "issuer": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "hostExposure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hostIP",
              "hostPort"
            ],
            "properties": {
              "hostIP": {
                "type": "string",
                "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              },
              "hostPort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "acme": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "enum": [
                  "production",
                  "staging"
                ]
              },
              "acceptTerms": {
                "type": "boolean"
              },
              "cacheDir": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "domain",
                "environment",
                "acceptTerms",
                "cacheDir"
              ]
            }
          },
          "backup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "dir": {
                "type": "string",
                "minLength": 1
              },
              "recipients": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^age1[02-9ac-hj-np-z]{58}$"
                }
              },
              "mode": {
                "enum": [
                  "full",
                  "database"
                ]
              },
              "intervalHours": {
                "type": "integer",
                "minimum": 0
              },
              "keepLast": {
                "type": "integer",
                "minimum": 1
              },
              "keepDays": {
                "type": "integer",
                "minimum": 0
              },
              "maxAssetMiB": {
                "type": "integer",
                "minimum": 0
              },
              "s3": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "endpoint": {
                    "type": "string",
                    "pattern": "^https?://[^/\\s]+/?$"
                  },
                  "bucket": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "prefix": {
                    "type": "string"
                  },
                  "pathStyle": {
                    "type": "boolean"
                  },
                  "partMiB": {
                    "type": "integer",
                    "minimum": 5
                  },
                  "keepLast": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "keepDays": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "credentialsSecret": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "accessKeyIdKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "secretAccessKeyKey": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "endpoint",
                    "bucket"
                  ]
                }
              }
            },
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "dir",
                "recipients"
              ]
            }
          }
        }
      }
    }
  }
}
