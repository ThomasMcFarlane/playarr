{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["workloads"],
  "properties": {
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image", "imagePullPolicy", "replicas", "containerPort", "routes"],
        "properties": {
          "image": {"type": "string", "minLength": 1},
          "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
          "replicas": {"type": "integer", "minimum": 0},
          "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
          "command": {"type": "array", "items": {"type": "string"}},
          "env": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {"type": "string"},
                "value": {"type": "string"}
              }
            }
          },
          "workingDir": {"type": "string"},
          "podSecurityContext": {"type": "object"},
          "hostPathVolumes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path", "type", "mounts"],
              "properties": {
                "name": {"type": "string"},
                "path": {"type": "string"},
                "type": {"type": "string"},
                "mounts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["mountPath"],
                    "properties": {
                      "mountPath": {"type": "string"},
                      "readOnly": {"type": "boolean"}
                    }
                  }
                }
              }
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "host"],
              "properties": {
                "name": {"type": "string"},
                "host": {"type": "string"},
                "hostRewrite": {"type": "string"},
                "websocket": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
