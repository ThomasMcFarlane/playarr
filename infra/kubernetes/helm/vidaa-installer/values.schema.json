{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "ttl",
        "clients"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "disabled",
            "allowlist",
            "all"
          ]
        },
        "ttl": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cidr",
              "enabled"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(3[0-2]|[12]?[0-9])$"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "tlsSecretName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tlsSecretName": {
          "type": "string",
          "maxLength": 253
        }
      }
    }
  },
  "required": [
    "dns",
    "ingress"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "tlsSecretName": {
                "minLength": 1,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    }
  ]
}
