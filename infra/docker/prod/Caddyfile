# ==============================================================================
# Reference Caddyfile for docker-compose.prod.yml.
#
# {$PLAYARR_DOMAIN} lets you point this at a real public hostname (Caddy
# then handles ACME/Let's Encrypt automatically on :443) while defaulting to
# `localhost` for a local smoke-test of the reference stack, where Caddy
# serves plain HTTP on :80 and a locally-trusted cert on :443 without any
# external ACME call.
#
# Proxies to the single `playarr` container (Playarr is SQLite-only, ADR
# 0002, so there is one server per database; nodes in a multi-node
# deployment are independent stacks that use peer sync).
#
# The metrics port (9090) is deliberately NOT proxied here -- Prometheus
# (see ../observability/docker-compose.yml) scrapes playarr:9090
# directly over the internal Docker network, and /metrics should never be
# reachable from the public edge.
# ==============================================================================

{$PLAYARR_DOMAIN:localhost} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	reverse_proxy playarr:8484 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
		health_status 200

		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}
