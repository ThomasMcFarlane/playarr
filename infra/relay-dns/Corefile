        answer "{{ .Name }} 60 IN A {{ index .Match 1 }}.{{ index .Match 2 }}.{{ index .Match 3 }}.{{ index .Match 4 }}"
        fallthrough
    }

    file /etc/streamarr-relay-dns/db.relay.playarr.app relay.playarr.app
}
