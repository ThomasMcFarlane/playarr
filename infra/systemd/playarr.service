[Unit]
Description=Playarr Server media automation service
Documentation=https://github.com/ThomasMcFarlane/playarr
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=playarr
Group=playarr

# EnvironmentFile is prefixed with "-" so a missing file doesn't block
# startup, but playarr will fail its own config validation (and this
# unit will then just keep restarting - see Restart= below) without a real
# DATABASE_URL (a sqlite: URL) in it. install.sh seeds this path from
# playarr.env.example if it doesn't already exist.
EnvironmentFile=-/etc/playarr/playarr.env

# This unit always runs the single-binary "all-in-one" role (API + worker
# in one process) - that's the systemd deployment model. Playarr is
# SQLite-only (ADR 0002), so there is one process per database; several
# nodes cooperate through peer sync.
Environment=PLAYARR_ROLE=all

ExecStart=/usr/local/bin/playarr-server
WorkingDirectory=/var/lib/playarr

Restart=on-failure
RestartSec=5

# Give the process time to drain in-flight requests/jobs on SIGTERM before
# systemd escalates to SIGKILL. Keep in sync with any internal graceful
# shutdown timeout playarr implements.
TimeoutStopSec=30

# --- Sandboxing / hardening ---------------------------------------------
# Conservative defaults; relax individual settings if playarr needs
# broader filesystem/network/device access than this allows.
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/playarr /var/log/playarr
UMask=0027

[Install]
WantedBy=multi-user.target
