# Copy to /etc/streamarr/streamarr.env (install.sh does this for you if the
# file doesn't already exist) and fill in real values. This file is loaded
# by both streamarr.service and streamarr-update-check.service via
# EnvironmentFile=.
#
# Do not commit a filled-in copy of this file anywhere - it holds database
# and cache credentials. /etc/streamarr/streamarr.env should be
# root:streamarr-owned, mode 0640 (install.sh sets this).
#
# STREAMARR_ROLE is intentionally NOT set here: streamarr.service pins it
# to "all" directly in the unit file and that always wins over whatever is
# in this file (systemd applies Environment=/EnvironmentFile= directives in
# the order they appear in the unit, later wins for duplicate keys).

# --- Required --------------------------------------------------------------

# postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# redis://<host>:6379/0
REDIS_URL=

# --- Optional (defaults shown match values.yaml's Kubernetes ConfigMap
# defaults, for parity between the two deployment paths). These are the
# real env vars streamarr-config::Config::from_env reads -- see
# backend/crates/streamarr-config/src/lib.rs. -------------------------------

STREAMARR_LOG=info
STREAMARR_HTTP_BIND_ADDR=0.0.0.0:8484
STREAMARR_METRICS_BIND_ADDR=0.0.0.0:9090

# Optional native HTTPS. Set both paths or neither. The private key must be
# readable by the streamarr group; no reverse proxy or TLS terminator is used.
# STREAMARR_TLS_CERT_PATH=/etc/streamarr/tls/fullchain.pem
# STREAMARR_TLS_KEY_PATH=/etc/streamarr/tls/privkey.pem

# Optional Streamarr Admin static Web build, served at /.
STREAMARR_WEB_ASSETS_DIR=/var/lib/streamarr/web

# --- Invite approval push notifications (optional) ------------------------
# Keep the Firebase service-account JSON outside the repository and readable
# only by the streamarr service account.
GOOGLE_APPLICATION_CREDENTIALS=/etc/streamarr/firebase-service-account.json

# One-line JSON containing api_key, auth_domain, project_id, storage_bucket,
# messaging_sender_id, app_id, and vapid_public_key. These are Firebase's
# public web-app values; the service-account file above is the secret.
STREAMARR_FIREBASE_WEB_CONFIG=
