[Unit]
Description=Streamarr update check (check-only, does not install anything)
Documentation=https://github.com/streamarr/streamarr
# Avoid racing a real deploy/restart of the main service.
After=streamarr.service

[Service]
Type=oneshot
User=streamarr
Group=streamarr
EnvironmentFile=-/etc/streamarr/streamarr.env

# --check-only (or equivalent) MUST exit non-zero only on a real error
# (network failure, malformed response) - "update available" is logged,
# not treated as a failure, so this unit's own success/failure state stays
# a meaningful health signal in `systemctl status`.
#
# This performs a read-only version check against the configured update
# feed and logs the result to the journal (`journalctl -u
# streamarr-update-check.service`). It never downloads, installs, restarts,
# or otherwise mutates the running deployment - upgrading stays a human
# (or CI/CD, e.g. the Flux GitOps path used for the Kubernetes deployment;
# see ../kubernetes/flux-image-automation.example.yaml) decision.
ExecStart=/usr/local/bin/streamarr update check --log-only

# Hardening, same posture as streamarr.service.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/streamarr /var/log/streamarr
