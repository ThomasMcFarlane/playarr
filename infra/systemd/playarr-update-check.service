[Unit]
Description=Playarr Server update check (check-only, does not install anything)
Documentation=https://github.com/ThomasMcFarlane/playarr
# Avoid racing a real deploy/restart of the main service.
After=playarr.service

[Service]
Type=oneshot
User=playarr
Group=playarr
EnvironmentFile=-/etc/playarr/playarr.env

# `update --check` is a flag on the `update` subcommand, not a nested
# subcommand of its own -- see backend/src/main.rs's Command::Update.
#
# KNOWN GAP: check_for_update() in backend/src/main.rs is currently a stub
# (always reports "up to date", no real network call against any release
# feed yet) -- this unit runs and exits 0 every time, but isn't yet a real
# update signal. Once real release-feed checking lands, this performs a
# read-only version check and logs the result to the journal (`journalctl
# -u playarr-update-check.service`). It never downloads, installs,
# restarts, or otherwise mutates the running deployment either way -
# upgrading stays a human (or CI/CD, e.g. the Flux GitOps path used for the
# Kubernetes deployment; see ../kubernetes/flux-image-automation.example.yaml)
# decision.
ExecStart=/usr/local/bin/playarr-server update --check

# Hardening, same posture as playarr.service.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/playarr /var/log/playarr
