# Copy to /etc/playarr/playarr.env (install.sh does this for you if the
# file doesn't already exist) and fill in real values. This file is loaded
# by both playarr.service and playarr-update-check.service via
# EnvironmentFile=.
#
# Do not commit a filled-in copy of this file anywhere - it can hold secrets
# such as the JWT secret. /etc/playarr/playarr.env should be
# root:playarr-owned, mode 0640 (install.sh sets this).
#
# PLAYARR_ROLE is intentionally NOT set here: playarr.service pins it
# to "all" directly in the unit file and that always wins over whatever is
# in this file (systemd applies Environment=/EnvironmentFile= directives in
# the order they appear in the unit, later wins for duplicate keys).

# --- Required --------------------------------------------------------------

# Playarr is SQLite-only (ADR 0002); a postgres:// URL is rejected at startup.
DATABASE_URL=sqlite:///var/lib/playarr/playarr.db

# --- Optional (defaults shown match values.yaml's Kubernetes ConfigMap
# defaults, for parity between the two deployment paths). These are the
# real env vars playarr-config::Config::from_env reads -- see
# backend/crates/playarr-config/src/lib.rs. -------------------------------

PLAYARR_LOG=info
PLAYARR_HTTP_BIND_ADDR=0.0.0.0:8484
PLAYARR_METRICS_BIND_ADDR=0.0.0.0:9090

# Optional native HTTPS. Set both paths or neither. The private key must be
# readable by the playarr group; no reverse proxy or TLS terminator is used.
# PLAYARR_TLS_CERT_PATH=/etc/playarr/tls/fullchain.pem
# PLAYARR_TLS_KEY_PATH=/etc/playarr/tls/privkey.pem

# Optional automatic HTTPS managed inside Playarr Server. By default this uses
# Let's Encrypt HTTP-01 on port 80, stores account/certificate state locally, and renews the
# certificate without a service restart. Do not combine this with the static
# PLAYARR_TLS_* paths above. The environment must be stated explicitly so a
# staging certificate cannot be mistaken for a browser-trusted production one.
# PLAYARR_ACME_DOMAIN=v4-203-0-113-10.relay.playarr.app
# PLAYARR_ACME_ENVIRONMENT=production
# PLAYARR_ACME_ACCEPT_TERMS=true
# PLAYARR_ACME_CONTACT=admin@example.com
# PLAYARR_ACME_CACHE_DIR=/var/lib/playarr/acme
# PLAYARR_ACME_HTTP01_BIND_ADDR=0.0.0.0:80

# Optional public relay phone-home. The server tells playarr.app its public
# IPv4 address (on start, on change and hourly); playarr.app calls back on
# http://<ip>:8484/.well-known/playarr-relay/<token> and publishes the DNS-only
# v4-A-B-C-D.relay.playarr.app record. Sends your public IPv4 address and a key
# fingerprint to playarr.app, so it is off unless enabled.
# PLAYARR_RELAY_REGISTER=true
# Override the address instead of letting playarr.app report the one it sees:
# PLAYARR_PUBLIC_IPV4=203.0.113.10
# For ACME without port 80 (needs PLAYARR_RELAY_REGISTER=true and a
# v4-A-B-C-D.relay.playarr.app domain); the default is http-01:
# PLAYARR_ACME_CHALLENGE=relay-dns-01

# Optional Playarr Server Admin static Web build, served at /.
PLAYARR_WEB_ASSETS_DIR=/var/lib/playarr/web

# --- Invite approval push notifications (optional) ------------------------
# Keep the Firebase service-account JSON outside the repository and readable
# only by the playarr service account.
GOOGLE_APPLICATION_CREDENTIALS=/etc/playarr/firebase-service-account.json

# One-line JSON containing api_key, auth_domain, project_id, storage_bucket,
# messaging_sender_id, app_id, and vapid_public_key. These are Firebase's
# public web-app values; the service-account file above is the secret.
PLAYARR_FIREBASE_WEB_CONFIG=
