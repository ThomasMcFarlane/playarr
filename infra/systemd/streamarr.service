[Unit]
Description=Streamarr media automation service
Documentation=https://github.com/streamarr/streamarr
After=network-online.target
Wants=network-online.target
# If Postgres/Redis run on this same host, uncomment so streamarr starts
# after them (remove if DATABASE_URL/REDIS_URL point at remote hosts):
# After=postgresql.service redis.service
# Wants=postgresql.service redis.service

[Service]
Type=simple
User=streamarr
Group=streamarr

# EnvironmentFile is prefixed with "-" so a missing file doesn't block
# startup, but streamarr will fail its own config validation (and this
# unit will then just keep restarting - see Restart= below) without a real
# DATABASE_URL / REDIS_URL in it. install.sh seeds this path from
# streamarr.env.example if it doesn't already exist.
EnvironmentFile=-/etc/streamarr/streamarr.env

# This unit always runs the single-binary "all-in-one" role (API + worker
# in one process) - that's the systemd deployment model. The split
# api/worker Deployments are a Kubernetes-only pattern; see
# ../kubernetes/README.md if you need that separation on bare metal too
# (run two copies of this unit under different names with
# STREAMARR_ROLE=api / STREAMARR_ROLE=worker instead).
Environment=STREAMARR_ROLE=all

ExecStart=/usr/local/bin/streamarr
WorkingDirectory=/var/lib/streamarr

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# Give the process time to drain in-flight requests/jobs on SIGTERM before
# systemd escalates to SIGKILL. Keep in sync with any internal graceful
# shutdown timeout streamarr implements.
TimeoutStopSec=30

# --- Sandboxing / hardening ---------------------------------------------
# Conservative defaults; relax individual settings if streamarr needs
# broader filesystem/network/device access than this allows.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/streamarr /var/log/streamarr
UMask=0027

[Install]
WantedBy=multi-user.target
