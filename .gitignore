# ==============================================================================
# Playarr Server / Playarr monorepo .gitignore
# Covers: Rust (backend), Node/pnpm (tv-web client), Gradle (Android clients),
# Xcode (iOS client), plus general OS/editor junk.
# Component-specific rules can still live in per-directory .gitignore files;
# this root file catches the common cases everywhere in the tree.
# ==============================================================================

# ------------------------------------------------------------------------
# Rust (backend/)
# ------------------------------------------------------------------------
/target/
**/target/
Cargo.lock.bak
# Keep Cargo.lock for the backend binary (reproducible builds), but ignore
# lockfiles accidentally generated inside example/scratch crates.
**/*.rs.bk
*.pdb
# Local SQLite dev databases (e.g. `DATABASE_URL=sqlite://./dev-playarr.db`
# for `cargo run` outside a real deployment) -- never meant to be committed.
*.db
*.db-shm
*.db-wal

# ------------------------------------------------------------------------
# Node / pnpm / TypeScript (clients/tv-web/ and any other JS tooling)
# ------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
out/
.turbo/
.next/
.nuxt/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.env
.env.local
.env.*.local
coverage/
/clients/tv-web/web/public/vidaa-store/

# ------------------------------------------------------------------------
# Gradle / Android / Kotlin (clients/android/)
# ------------------------------------------------------------------------
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties
build/
captures/
.externalNativeBuild/
.cxx/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
freeline.py
freeline/
freeline_project_description.json
.navigation/
*.keystore
!debug.keystore

# ------------------------------------------------------------------------
# Xcode / Swift / CocoaPods / Carthage / SwiftPM (clients/ios/)
# ------------------------------------------------------------------------
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.hmap
*.ipa
*.xcarchive
.build/
Pods/
Carthage/Build/
Carthage/Checkouts/
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ------------------------------------------------------------------------
# Tizen / webOS / VIDAA native tooling (packaging artifacts, not source)
# ------------------------------------------------------------------------
*.wgt
*.ipk
*.tpk
.tproject
.buildResult/

# ------------------------------------------------------------------------
# HarmonyOS NEXT / OpenHarmony tooling (build + packaging artifacts)
# ------------------------------------------------------------------------
oh_modules/
.hvigor/
.clangd
.cxx/
*.hap
*.app
*.har
*.hsp
local.properties

# ------------------------------------------------------------------------
# Docker / Kubernetes / infra scratch state
# ------------------------------------------------------------------------
*.tfstate
*.tfstate.*
.terraform/

# ------------------------------------------------------------------------
# General OS / editor / IDE junk
# ------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/*
!.vscode/extensions.json
*.iml
*.swp
*.swo
*~
.history/

# Local browser automation helpers and runtime state
.chrome-mcp-extension/
.local-data/
**/.fastembed_cache/
/backend/run-dev.sh

# ------------------------------------------------------------------------
# Logs, env files, and local secrets that should never be committed
# ------------------------------------------------------------------------
*.log
logs/
.env
.env.*
!.env.example
secrets/
*.pem
*.key
!**/test-fixtures/**/*.key

# Local browser-automation scratch: MCP session state and ad-hoc TV-web
# screenshots dropped at the repo root during manual UI checks.
.playwright-mcp/
/tvweb_*.png
