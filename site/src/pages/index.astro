---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import Card from '../components/Card.astro'
import Pill from '../components/Pill.astro'
import ButtonLink from '../components/ButtonLink.astro'
import AppFrame from '../components/AppFrame.astro'
import Icon from '../components/Icon.astro'
import { LINKS } from '../consts'
import { PLATFORMS } from '../data/platforms'
import { INTEGRATIONS } from '../data/integrations'
import serverAdminShot from '../assets/screenshots/playarr-server-admin.png'
import moviesLibraryShot from '../assets/screenshots/playarr-movies-library.png'
import movieDetailShot from '../assets/screenshots/playarr-movie-detail.png'
import musicLibraryShot from '../assets/screenshots/playarr-music-library.png'

const pillars = [
  {
    icon: 'grid',
    tone: 'brand',
    title: 'One library, properly catalogued',
    body: 'Films, series, music and books in a single catalogue, with posters, backdrops, cast and crew, chapters, subtitles and multiple audio tracks, matched against the identifiers your library tools already resolved.',
  },
  {
    icon: 'play',
    tone: 'amber',
    title: 'Plays on the hardware you own',
    body: 'Direct play with real seeking wherever the file already suits the screen, and server-side transcoding with a quality ladder when it does not. Library-wide re-encoding runs as a separate, lower-priority system that yields while people are watching.',
  },
  {
    icon: 'users',
    tone: 'teal',
    title: 'Accounts that fit a household',
    body: 'A profile picker with PINs and avatars, and library access that is denied until granted. Being an administrator does not silently make you a viewer, the two are separate grants on purpose.',
  },
  {
    icon: 'server',
    tone: 'violet',
    title: 'Your server stays yours',
    body: 'Self-hosted from the first byte. Nothing is brokered through a third party, there is no account to create with us, and the whole HTTP API is a published, generated OpenAPI contract you can build against.',
  },
] as const

const distinctive = [
  {
    icon: 'link',
    tone: 'violet',
    title: 'Federate with a friend, keep your own server',
    body: 'Peer groups let independently owned installations share accounts, permissions and catalogue metadata over a signed protocol, routing playback between each other. Run one server and it stays completely inert.',
  },
  {
    icon: 'cpu',
    tone: 'brand',
    title: 'One binary, Raspberry Pi to Kubernetes',
    body: 'The same executable runs single-node against SQLite or as independently scaled API and worker processes against Postgres. Growing is a configuration change, not different software.',
  },
  {
    icon: 'key',
    tone: 'amber',
    title: 'Pick your own authentication posture',
    body: 'Real accounts by default, or zero-credential auto-login on a trusted LAN if you opt into it, and that opt-in is restricted to private address ranges, so a stray port forward cannot hand over the admin console.',
  },
  {
    icon: 'brain',
    tone: 'teal',
    title: 'Recommendations that never leave the box',
    body: 'A small CPU-only sentence-embedding model powers "more like this" locally. No cloud API, no generative model, and offline once the model is fetched.',
  },
  {
    icon: 'lock',
    tone: 'brand',
    title: 'HTTPS without a reverse proxy',
    body: 'Built-in ACME with an HTTP-01 listener, so a home server can hold a real certificate without another moving part in front of it.',
  },
  {
    icon: 'code',
    tone: 'violet',
    title: 'The API is part of the product',
    body: 'The OpenAPI description is generated from the handlers, drift-tested in CI and served by the running server. The TypeScript client is generated from it, and so could yours be.',
  },
] as const

const showcase = [
  {
    image: movieDetailShot,
    alt: 'The Playarr detail page for The Test Film, showing chapters and similar titles',
    size: 'md',
    aspect: 'tall',
    offset: 'up',
    title: 'Every title, properly presented',
    body: 'Chapters, cast, runtime and a "similar titles" rail generated by a local embedding model, no cloud call involved.',
  },
  {
    image: musicLibraryShot,
    alt: 'The Playarr music library, showing real artists including Sample Artist L, Sample Artist M and Sample Artist N',
    size: 'sm',
    aspect: 'wide',
    offset: 'down',
    title: 'Music gets the same treatment',
    body: 'Artists, albums and tracks in the same catalogue as film and TV, matched against MusicBrainz identifiers from Lidarr.',
  },
  {
    image: serverAdminShot,
    alt: 'The Playarr Server admin panel, showing connected Radarr, Sonarr, Lidarr and Bazarr source instances',
    size: 'md',
    aspect: 'wide',
    offset: 'up',
    title: 'Manage the server centrally',
    body: 'Register the library tools you already run once, and the admin panel keeps the catalogue in sync with every one of them.',
  },
] as const

const notYet = [
  'Hardware-accelerated transcoding, software encoding only for now',
  'Chromecast and AirPlay',
  'Live TV, DVR, tuners and programme guides',
  'Protected-content playback',
  'A photos library',
  'Intro and credits detection, trailers and extras, watch-together, plugins',
]
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-intro" data-reveal>
      <div class="blob blob-a" aria-hidden="true"></div>
      <div class="blob blob-b" aria-hidden="true"></div>
      <p class="eyebrow">Self-hosted media server</p>
      <h1>Your library.<br />Every screen.</h1>
      <p class="hero-lede">
        Playarr turns the media you already own into a properly catalogued, genuinely
        watchable library, self-hosted on the server you run, and on the phone in your
        pocket, the tablet on the sofa and the television in the corner.
      </p>
      <div class="hero-actions">
        <ButtonLink href={LINKS.playarrApp} external>Open Playarr</ButtonLink>
        <ButtonLink href="/docs/install" variant="outline">Install the server</ButtonLink>
      </div>
      <p class="hero-note">
        Free and open source under the MIT licence. No account with us, no telemetry to opt
        out of, no tier that unlocks your own hardware.
      </p>
    </div>

    <div class="split">
      <div class="split-half split-server" data-reveal>
        <div class="split-copy">
          <p class="split-kicker">
            <Icon name="server" /> Playarr Server
          </p>
          <p>
            Self-hosted from the first byte. One binary that runs on a Raspberry Pi or scales
            out across Kubernetes, with the admin panel that keeps it all in sync.
          </p>
        </div>
        <AppFrame size="lg" aspect="wide" class="split-frame">
          <Image src={serverAdminShot} alt="The Playarr Server admin panel, showing connected Radarr, Sonarr, Lidarr and Bazarr source instances" />
        </AppFrame>
      </div>
      <div class="split-half split-client" data-reveal data-reveal-delay="120">
        <div class="split-copy">
          <p class="split-kicker">
            <Icon name="play" /> Playarr
          </p>
          <p>
            What everyone actually watches on: a phone, a tablet, a television in the corner,
            or a browser tab, all speaking to the server behind them.
          </p>
        </div>
        <AppFrame size="lg" aspect="wide" class="split-frame">
          <Image src={moviesLibraryShot} alt="The Playarr movie library, showing real film posters including The Test Film, Sample Movie Alpha and Sample Animation" />
        </AppFrame>
      </div>
    </div>
    <p class="illustrative-note wrap">
      Real interface, real screenshots. The titles and cover art shown are a sample library
      for demonstration, not anyone's personal collection.
    </p>
  </section>

  <Section
    tint
    eyebrow="What it is"
    title="The playback layer your setup is missing"
    lede="You already have the storage and the tools that keep it tidy. Playarr is the part that makes it a pleasure to actually watch."
  >
    <div class="grid-4">
      {
        pillars.map((item, i) => (
          <div data-reveal data-reveal-delay={i * 70}>
            <Card title={item.title} tone={item.tone}>
              <Icon name={item.icon} slot="icon" />
              <p>{item.body}</p>
            </Card>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    eyebrow="A closer look"
    title="What the interface actually looks like"
    lede="Real screenshots of the real interface, populated with a sample library of recognisable titles for this demonstration, not a personal collection."
  >
    <div class="showcase">
      {
        showcase.map((item, i) => (
          <div
            class:list={['showcase-item', `offset-${item.offset}`]}
            data-reveal
            data-reveal-delay={i * 120}
          >
            <AppFrame size={item.size} aspect={item.aspect}>
              <Image src={item.image} alt={item.alt} />
            </AppFrame>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section
    eyebrow="Every screen"
    title="Playarr, on the devices you already watch on"
    lede="Real native clients, Compose on Android, SwiftUI on Apple platforms, SceneGraph on Roku, all speaking one versioned API contract. Not a single web view in seven wrappers."
    tint
  >
    <div class="platforms">
      {
        PLATFORMS.map((platform) => (
          <div class="platform">
            <div class="platform-head">
              <h3>{platform.name}</h3>
              <Pill tone={platform.tone}>{platform.status}</Pill>
            </div>
            <p class="platform-devices">{platform.devices}</p>
            <p class="platform-route">{platform.route}</p>
          </div>
        ))
      }
    </div>
    <p class="after">
      <ButtonLink href="/apps" variant="quiet">See how each one installs →</ButtonLink>
    </p>
  </Section>

  <Section
    eyebrow="Integrations"
    title="Works with the library managers you already run"
    lede="Playarr reads the library those tools have already organised, the titles, the file paths and the identifiers they resolved. It performs no indexing and obtains no media itself."
  >
    <div class="integrations">
      {
        INTEGRATIONS.map((integration) => (
          <div class="integration">
            <h3>{integration.name}</h3>
            <p class="integration-role">{integration.role}</p>
            <p>{integration.reads}</p>
          </div>
        ))
      }
    </div>
    <p class="after">
      <ButtonLink href="/integrations" variant="quiet">What each one contributes →</ButtonLink>
    </p>
  </Section>

  <Section
    tint
    eyebrow="Why this one"
    title="Things you will not find in the alternatives"
    lede="Some of these are unusual. All of them are in the repository today."
  >
    <div class="grid-3">
      {
        distinctive.map((item, i) => (
          <div data-reveal data-reveal-delay={(i % 3) * 70}>
            <Card title={item.title} tone={item.tone}>
              <Icon name={item.icon} slot="icon" />
              <p>{item.body}</p>
            </Card>
          </div>
        ))
      }
    </div>
  </Section>

  <Section eyebrow="Straight answers" title="What it does not do yet">
    <div class="honest">
      <p class="lede">
        Playarr is early. There is no 1.0, nothing is on an app store, and several television
        clients install through developer mode. Here is what is genuinely missing, so you can
        decide before you spend an evening on it:
      </p>
      <ul class="gaps">
        {notYet.map((gap) => <li>{gap}</li>)}
      </ul>
      <p>
        The <a href={LINKS.repo} rel="noopener">repository</a> tracks all of this in the open, and the
        installation guides label anything that is not built yet.
      </p>
    </div>
  </Section>

  <section class="closing">
    <div class="blob blob-c" aria-hidden="true"></div>
    <div class="wrap closing-inner">
      <h2>Point it at your library and see.</h2>
      <p class="lede">
        A single binary and a media path is enough to get a catalogue on screen. The hosted
        Playarr web app will talk to it as soon as it is running.
      </p>
      <div class="hero-actions">
        <ButtonLink href="/docs/install">Choose your setup</ButtonLink>
        <ButtonLink href={LINKS.playarrApp} variant="outline" external>Open Playarr</ButtonLink>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(var(--space-8), 9vw, var(--space-9));
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .blob {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    animation: drift 16s ease-in-out infinite;
  }

  .blob-a {
    top: -18%;
    left: -8%;
    width: 46vw;
    height: 46vw;
    max-width: 620px;
    max-height: 620px;
    background: radial-gradient(circle, var(--brand-tint-strong), transparent 70%);
  }

  .blob-b {
    top: 8%;
    right: -12%;
    width: 34vw;
    height: 34vw;
    max-width: 480px;
    max-height: 480px;
    background: radial-gradient(circle, var(--hue-violet-tint), transparent 70%);
    animation-delay: -6s;
  }

  .blob-c {
    top: -30%;
    left: 50%;
    width: 50vw;
    height: 50vw;
    max-width: 700px;
    max-height: 700px;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--brand-tint), transparent 70%);
    filter: blur(80px);
    animation: drift 20s ease-in-out infinite;
  }

  .hero-intro {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin-inline: auto;
    padding-bottom: clamp(var(--space-7), 6vw, var(--space-8));
    text-align: center;
  }

  .hero h1 {
    margin-bottom: var(--space-5);
    font-size: var(--text-hero);
    letter-spacing: -0.035em;
  }

  .hero-lede {
    max-width: 56ch;
    margin-inline: auto;
    margin-bottom: var(--space-7);
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-note {
    max-width: 48ch;
    margin-inline: auto;
    margin-bottom: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  /* The two-halves showcase: Playarr Server (self-hosted backend) on the
     left, Playarr (what people actually watch on) on the right, each with
     its own colour so the two never read as one undifferentiated product. */
  .split {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .split-half {
    position: relative;
    z-index: 1;
    padding: clamp(var(--space-6), 5vw, var(--space-8)) clamp(var(--space-5), 6vw, var(--space-8));
  }

  .split-server {
    background: linear-gradient(180deg, var(--hue-teal-tint), transparent 65%);
    border-right: 1px solid var(--line);
  }

  .split-client {
    background: linear-gradient(180deg, var(--brand-tint), transparent 65%);
  }

  .split-copy {
    max-width: 46ch;
    margin-bottom: var(--space-5);
  }

  .split-copy p {
    margin: 0;
    color: var(--ink-soft);
  }

  .split-kicker {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: var(--space-2) !important;
    font-size: var(--text-sm);
    font-weight: 750;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .split-kicker :global(svg) {
    width: 16px;
    height: 16px;
  }

  .split-server .split-kicker {
    color: var(--hue-teal);
  }

  .split-client .split-kicker {
    color: var(--brand);
  }

  .split-frame {
    box-shadow: var(--shadow-soft);
  }

  .illustrative-note {
    margin-top: var(--space-6);
    margin-bottom: 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  @media (max-width: 940px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .split-server {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
  }

  /*
   * Bento layout: an explicit 4-column track rather than auto-fit, so
   * specific cards can be given a deliberate span instead of every cell
   * being the same size. The wrapping [data-reveal] div is the actual grid
   * item (Card sits inside it), so it needs `display: flex` for its Card
   * child to stretch across a spanned, taller cell instead of leaving empty
   * space at the card's own natural content height.
   */
  .grid-4,
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(180px, auto);
    gap: var(--space-5);
  }

  .grid-4 > div,
  .grid-3 > div {
    display: flex;
  }

  .grid-4 > div :global(.card),
  .grid-3 > div :global(.card) {
    flex: 1;
  }

  .grid-4 > div:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .grid-4 > div:nth-child(4) {
    grid-column: span 2;
  }

  .grid-3 > div:nth-child(1) {
    grid-column: span 2;
    grid-row: span 2;
  }

  .grid-3 > div:nth-child(4) {
    grid-column: span 2;
  }

  @media (max-width: 1100px) {
    .grid-4,
    .grid-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .grid-4,
    .grid-3 {
      grid-template-columns: minmax(0, 1fr);
    }

    .grid-4 > div:nth-child(1),
    .grid-4 > div:nth-child(4),
    .grid-3 > div:nth-child(1),
    .grid-3 > div:nth-child(4) {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  /*
   * A staggered row rather than a straight grid: alternating vertical offset
   * and a slight rotation per card, closer to a scattered stack of screens
   * than a spreadsheet. The offset is a margin, not a transform, precisely
   * so it never fights the [data-reveal] entrance transform on this same
   * element, the two need to compose, not override each other.
   */
  .showcase {
    display: grid;
    gap: var(--space-9) var(--space-6);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
  }

  .showcase-item.offset-down {
    margin-top: clamp(28px, 6vw, 64px);
  }

  .showcase-item :global(.frame) {
    transition: transform var(--dur) var(--ease-out);
  }

  .showcase-item:nth-child(3n + 1) :global(.frame) {
    transform: rotate(-2deg);
  }

  .showcase-item:nth-child(3n + 2) :global(.frame) {
    transform: rotate(1.6deg);
  }

  .showcase-item:nth-child(3n + 3) :global(.frame) {
    transform: rotate(-1deg);
  }

  .showcase-item:hover :global(.frame) {
    transform: rotate(0deg) scale(1.015);
  }

  .showcase-item h3 {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: var(--text-lg);
  }

  .showcase-item p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 860px) {
    .showcase {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase-item.offset-down {
      margin-top: 0;
    }
  }

  /*
   * Flex, not grid: the platform count doesn't divide evenly into any fixed
   * column count, and a trailing grid row leaves an empty, coloured ghost
   * cell where CSS grid still allocates a track. Flex-wrap just ends the row.
   */
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--line);
    overflow: hidden;
  }

  .platform {
    flex: 1 1 280px;
    padding: var(--space-5) var(--space-6);
    background: var(--bg);
  }

  .platform-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .platform h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .platform-devices {
    margin-bottom: var(--space-2);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .platform-route {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .integrations {
    display: grid;
    gap: var(--space-6) var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  }

  .integration h3 {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
  }

  .integration-role {
    margin-bottom: var(--space-3);
    color: var(--brand);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .integration p:last-child {
    margin-bottom: 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .after {
    margin-top: var(--space-6);
    margin-bottom: 0;
  }

  .honest {
    max-width: var(--width-prose);
  }

  .gaps {
    margin: var(--space-5) 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .gaps li {
    padding-inline-start: 1.5em;
    position: relative;
    color: var(--ink-soft);
  }

  .gaps li::before {
    content: '\2013';
    position: absolute;
    left: 0;
    color: var(--ink-muted);
  }

  .closing {
    position: relative;
    padding-block: clamp(var(--space-8), 9vw, var(--space-10));
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .closing-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
  }

  .closing h2 {
    font-size: var(--text-3xl);
  }
</style>
