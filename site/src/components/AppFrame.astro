---
/*
 * Browser-chrome shell used to present the fictional DemoScreen mockups (see
 * DemoScreen.astro and data/demo-content.ts) as if seen in a browser tab.
 * Deliberately illustrative, not a screenshot: nothing rendered inside it is
 * a capture of a real Streamarr installation.
 */
interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Visual weight in a stacked showcase — larger frames sit forward. */
  size?: 'lg' | 'md' | 'sm'
  /** 'tall' suits detail-page style content (hero + rails); 'wide' suits grids. */
  aspect?: 'wide' | 'tall'
  class?: string
}

const { size = 'md', aspect = 'wide', class: className, ...rest } = Astro.props
---

<figure class:list={['frame', size, aspect, className]} {...rest}>
  <div class="chrome">
    <span class="dot red"></span>
    <span class="dot amber"></span>
    <span class="dot green"></span>
    <span class="url">playarr.app</span>
  </div>
  <div class="viewport">
    <slot />
  </div>
</figure>

<style>
  .frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-strong);
    box-shadow: var(--shadow-soft);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .frame .dot.red {
    background: #e0685f;
  }
  .frame .dot.amber {
    background: #e5b04b;
  }
  .frame .dot.green {
    background: #5fb56a;
  }

  .url {
    margin-inline-start: var(--space-3);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--ink-muted);
    font-size: 0.68rem;
    font-weight: 650;
  }

  .wide .viewport {
    aspect-ratio: 16 / 10;
  }

  .lg.wide .viewport {
    aspect-ratio: 16 / 9;
  }

  .tall .viewport {
    aspect-ratio: 1 / 1;
  }
</style>
