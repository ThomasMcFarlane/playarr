---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

/*
 * Browser-chrome mockup for real product screenshots. Every screenshot in
 * src/assets/ is a genuine capture of the tv-web client (see the tvweb_*.png
 * files at the repo root this was copied from) — nothing here is a stock
 * photo or a fabricated UI.
 */
interface Props {
  src: ImageMetadata
  alt: string
  /** Visual weight in a stacked showcase — larger frames sit forward. */
  size?: 'lg' | 'md' | 'sm'
  class?: string
  priority?: boolean
}

const { src, alt, size = 'md', class: className, priority = false } = Astro.props

const widths: Record<string, number> = { lg: 1200, md: 860, sm: 620 }
---

<figure class:list={['frame', size, className]}>
  <div class="chrome">
    <span class="dot red"></span>
    <span class="dot amber"></span>
    <span class="dot green"></span>
    <span class="url">playarr.app</span>
  </div>
  <div class="viewport">
    <Image
      src={src}
      alt={alt}
      width={widths[size]}
      widths={[widths[size], Math.round(widths[size] * 1.6)]}
      sizes={`(max-width: 760px) 92vw, ${widths[size]}px`}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      format="webp"
      quality={82}
    />
  </div>
</figure>

<style>
  .frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-strong);
    box-shadow: var(--shadow-soft);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  :root[data-theme='light'] .dot.red,
  .frame .dot.red {
    background: #e0685f;
  }
  .frame .dot.amber {
    background: #e5b04b;
  }
  .frame .dot.green {
    background: #5fb56a;
  }

  .url {
    margin-inline-start: var(--space-3);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--ink-muted);
    font-size: 0.68rem;
    font-weight: 650;
  }

  .viewport {
    line-height: 0;
  }

  .viewport :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
