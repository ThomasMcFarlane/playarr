---
import Icon from './Icon.astro'
import { DEMO_MOVIES, DEMO_ARTISTS, DEMO_DETAIL, DEMO_PROFILES, type Tone } from '../data/demo-content'

/*
 * An illustrative mock of the Playarr interface, not a screenshot. Every
 * title, artist and person here is invented (see data/demo-content.ts) and
 * every "poster" is a CSS gradient, never an image, so nothing on this page
 * can be mistaken for a real library or for real cover art.
 */
interface Props {
  variant: 'library' | 'music' | 'detail' | 'profiles'
  class?: string
}

const { variant, class: className } = Astro.props

const RAIL_ICONS = ['grid', 'play', 'users', 'server'] as const

/** Maps a content tone to the matching CSS custom property name. */
function toneVar(t: Tone): string {
  return t === 'brand' ? 'brand' : `hue-${t}`
}
---

<div class:list={['demo-shell', className]}>
  <nav class="demo-rail" aria-hidden="true">
    {RAIL_ICONS.map((name) => <span class="rail-dot"><Icon name={name} /></span>)}
  </nav>

  <div class="demo-main">
    {
      variant === 'library' && (
        <>
          <header class="demo-head">
            <span class="demo-crumb">Movies</span>
            <span class="demo-count">{DEMO_MOVIES.length} titles</span>
          </header>
          <div class="demo-grid">
            {DEMO_MOVIES.map((m) => (
              <div class="demo-tile" style={`--t: var(--${toneVar(m.tone)})`}>
                <div class="demo-poster" />
                <p class="demo-tile-title">{m.title}</p>
                <p class="demo-tile-meta">{m.meta}</p>
              </div>
            ))}
          </div>
        </>
      )
    }

    {
      variant === 'music' && (
        <>
          <header class="demo-head">
            <span class="demo-crumb">Music</span>
            <span class="demo-count">{DEMO_ARTISTS.length} artists</span>
          </header>
          <div class="demo-grid demo-grid-round">
            {DEMO_ARTISTS.map((a) => (
              <div class="demo-tile" style={`--t: var(--${toneVar(a.tone)})`}>
                <div class="demo-poster demo-poster-round" />
                <p class="demo-tile-title">{a.title}</p>
                <p class="demo-tile-meta">{a.meta}</p>
              </div>
            ))}
          </div>
        </>
      )
    }

    {
      variant === 'detail' && (
        <>
          <div class="demo-detail-hero" style={`--t: var(--${toneVar(DEMO_DETAIL.tone)})`}>
            <div class="demo-backdrop" />
            <div class="demo-detail-copy">
              <h4>{DEMO_DETAIL.title}</h4>
              <p class="demo-tile-meta">{DEMO_DETAIL.meta}</p>
              <p class="demo-synopsis">{DEMO_DETAIL.synopsis}</p>
              <span class="demo-play"><Icon name="play" /> Play</span>
            </div>
          </div>
          <p class="demo-section-label">Chapters · {DEMO_DETAIL.chapters}</p>
          <div class="demo-chapter-row">
            {Array.from({ length: DEMO_DETAIL.chapters }).map(() => (
              <div class="demo-chapter" />
            ))}
          </div>
          <p class="demo-section-label">Similar titles</p>
          <div class="demo-similar-row">
            {DEMO_DETAIL.similar.map((m) => (
              <div class="demo-tile demo-tile-sm" style={`--t: var(--${toneVar(m.tone)})`}>
                <div class="demo-poster" />
              </div>
            ))}
          </div>
        </>
      )
    }

    {
      variant === 'profiles' && (
        <div class="demo-profiles">
          <p class="demo-profiles-title">Who's watching?</p>
          <div class="demo-profiles-row">
            {DEMO_PROFILES.map((p) => (
              <div class="demo-profile" style={`--t: var(--${toneVar(p.tone)})`}>
                <div class="demo-avatar">{p.name[0]}</div>
                <p class="demo-tile-meta">{p.name}</p>
              </div>
            ))}
            <div class="demo-profile">
              <div class="demo-avatar demo-avatar-add">+</div>
              <p class="demo-tile-meta">Add</p>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .demo-shell {
    display: flex;
    height: 100%;
    background: var(--surface-strong);
    font-family: var(--font);
  }

  .demo-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    flex: none;
    width: 44px;
    padding-block: 16px;
    border-inline-end: 1px solid var(--line);
    background: var(--surface);
  }

  .rail-dot {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    color: var(--ink-muted);
  }

  .rail-dot :global(svg) {
    width: 14px;
    height: 14px;
  }

  .rail-dot:first-child {
    color: var(--brand);
  }

  .demo-main {
    flex: 1;
    min-width: 0;
    padding: 16px 20px;
    overflow: hidden;
  }

  .demo-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
  }

  .demo-crumb {
    font-weight: 750;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .demo-count {
    color: var(--ink-muted);
    font-size: 0.68rem;
  }

  .demo-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(5, 1fr);
  }

  .demo-grid-round {
    grid-template-columns: repeat(6, 1fr);
  }

  .demo-tile-sm {
    width: 72px;
  }

  .demo-poster {
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    background: linear-gradient(150deg, var(--t) 0%, color-mix(in srgb, var(--t) 45%, var(--surface-strong)) 100%);
  }

  .demo-poster-round {
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .demo-tile-title {
    margin: 6px 0 0;
    font-size: 0.66rem;
    font-weight: 650;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .demo-tile-meta {
    margin: 1px 0 0;
    font-size: 0.58rem;
    color: var(--ink-muted);
  }

  .demo-detail-hero {
    position: relative;
    margin-bottom: 16px;
    padding: 20px;
    border-radius: 12px;
    overflow: hidden;
    color: var(--on-brand);
  }

  .demo-backdrop {
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, var(--t) 0%, color-mix(in srgb, var(--t) 60%, #150c10) 100%);
  }

  .demo-detail-copy {
    position: relative;
  }

  .demo-detail-copy h4 {
    margin: 0 0 4px;
    font-size: 1.1rem;
  }

  .demo-detail-copy .demo-tile-meta {
    color: rgba(255, 255, 255, 0.78);
    margin-bottom: 8px;
  }

  .demo-synopsis {
    max-width: 34ch;
    margin: 0 0 12px;
    font-size: 0.7rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
  }

  .demo-play {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .demo-play :global(svg) {
    width: 11px;
    height: 11px;
  }

  .demo-section-label {
    margin: 0 0 8px;
    color: var(--ink-muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .demo-chapter-row {
    display: flex;
    gap: 6px;
    margin-bottom: 16px;
  }

  .demo-chapter {
    width: 40px;
    height: 26px;
    border-radius: 6px;
    background: var(--surface-soft);
  }

  .demo-similar-row {
    display: flex;
    gap: 8px;
  }

  .demo-profiles {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
  }

  .demo-profiles-title {
    margin: 0 0 20px;
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--ink);
  }

  .demo-profiles-row {
    display: flex;
    gap: 22px;
  }

  .demo-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .demo-avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--t, var(--brand)) 0%, color-mix(in srgb, var(--t, var(--brand)) 50%, var(--surface-strong)) 100%);
    color: var(--on-brand);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .demo-avatar-add {
    background: var(--surface-soft);
    color: var(--ink-muted);
    font-size: 1.4rem;
  }
</style>
