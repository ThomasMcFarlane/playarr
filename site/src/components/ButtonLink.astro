---
interface Props {
  href: string
  variant?: 'solid' | 'outline' | 'quiet'
  external?: boolean
  class?: string
}

const { href, variant = 'solid', external = false, class: className } = Astro.props
---

<a
  href={href}
  class:list={['btn', variant, className]}
  rel={external ? 'noopener' : undefined}
>
  <slot />
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: 13px 26px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    transition:
      box-shadow var(--dur) var(--ease-out),
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease-out);
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .solid {
    background: linear-gradient(155deg, var(--brand-bright), var(--brand) 55%, var(--brand-strong));
    color: var(--on-brand);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.08),
      0 10px 26px var(--brand-tint-strong);
  }

  .solid:hover {
    color: var(--on-brand);
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.08),
      0 16px 36px var(--brand-tint-strong);
  }

  .outline {
    border-color: var(--line-strong);
    background: var(--surface);
    color: var(--ink);
  }

  .outline:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .quiet {
    padding-inline: 0;
    color: var(--ink-soft);
  }

  .quiet:hover {
    color: var(--brand);
    transform: none;
  }
</style>
