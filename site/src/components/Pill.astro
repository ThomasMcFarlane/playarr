---
/*
 * Availability badge. Marketing pages must not present planned work as
 * shipped, so every platform and feature that is not generally available
 * carries one of these.
 */
export type Tone = 'ok' | 'warn' | 'neutral'

interface Props {
  tone?: Tone
  class?: string
}

const { tone = 'neutral', class: className } = Astro.props
---

<span class:list={['pill', tone, className]}><slot /></span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-soft);
    color: var(--ink-soft);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .ok {
    border-color: transparent;
    background: var(--success-soft);
    color: var(--pill-ok-ink);
  }

  .warn {
    border-color: transparent;
    background: var(--danger-soft);
    color: var(--pill-warn-ink);
  }
</style>
