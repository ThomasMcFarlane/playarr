---
import Logo from './Logo.astro'
import ThemeToggle from './ThemeToggle.astro'
import { NAV, LINKS } from '../consts'

const path = Astro.url.pathname
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`)
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Streamarr home"><Logo /></a>

    <nav class="nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { current: isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="cta" href={LINKS.playarrApp} rel="noopener">Open Playarr</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(14px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 68px;
  }

  .brand {
    flex: none;
    text-decoration: none;
  }

  .brand:hover {
    color: inherit;
  }

  .nav {
    display: flex;
    flex: 1;
    gap: var(--space-5);
    margin-inline-start: var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav-link {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.current {
    color: var(--ink);
  }

  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-3);
  }

  .cta {
    padding: 9px 18px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--bg);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .cta:hover {
    color: var(--bg);
    opacity: 0.84;
  }

  @media (max-width: 860px) {
    .bar {
      flex-wrap: wrap;
      padding-block: var(--space-3);
    }

    .nav {
      order: 3;
      width: 100%;
      margin-inline-start: 0;
      padding-bottom: var(--space-1);
    }

    .actions {
      margin-inline-start: auto;
    }
  }
</style>
