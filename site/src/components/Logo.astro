---
/*
 * Wordmark for the marketing site: the real Playarr app icon (the play
 * symbol with three orbiting rings, clients/tv-web/web/public/playarr-icon.svg,
 * copied to public/playarr-icon.svg) set beside the product name. The icon
 * carries its own gradient and reads correctly in both themes unmodified, so
 * unlike a currentColor glyph it needs no theme-specific handling here.
 */
interface Props {
  /** Hide the word and render the mark alone, for tight spaces. */
  markOnly?: boolean
  class?: string
}

const { markOnly = false, class: className } = Astro.props
---

<span class:list={['logo', className]}>
  <img class="logo-mark" src="/playarr-icon.svg" alt="" width="32" height="32" />
  {markOnly ? null : <span class="logo-word">Playarr</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
    font-weight: 750;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .logo-mark {
    display: block;
    width: 1.85em;
    height: 1.85em;
    flex: none;
  }

  .logo-word {
    display: block;
    line-height: 1;
  }
</style>
