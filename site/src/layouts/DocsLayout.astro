---
import BaseLayout from './BaseLayout.astro'
import { getCollection } from 'astro:content'

interface Props {
  title: string
  summary: string
  /** Collection id of the page being rendered, so the sidebar can mark it. */
  current?: string
}

const { title, summary, current } = Astro.props

const GROUP_ORDER = ['Install', 'Setup', 'Clients', 'Operate'] as const

const entries = (await getCollection('docs', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
)

const groups = GROUP_ORDER.map((name) => ({
  name,
  items: entries.filter((entry) => entry.data.group === name),
})).filter((group) => group.items.length > 0)
---

<BaseLayout title={title} description={summary}>
  <div class="docs">
    <aside class="sidebar">
      <nav aria-label="Documentation">
        {
          groups.map((group) => (
            <div class="group">
              <h2 class="group-title">{group.name}</h2>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a
                      href={`/docs/${item.id}`}
                      class:list={['side-link', { current: item.id === current }]}
                      aria-current={item.id === current ? 'page' : undefined}
                    >
                      <span>{item.data.title}</span>
                      {item.data.badge && <em class="badge">{item.data.badge}</em>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <article class="doc-body">
      <header class="doc-head">
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </header>
      <slot />
    </article>
  </div>
</BaseLayout>

<style>
  .docs {
    display: grid;
    width: 100%;
    max-width: var(--width-docs);
    margin-inline: auto;
    padding: var(--space-7) var(--gutter) var(--space-9);
    gap: clamp(var(--space-6), 5vw, var(--space-9));
    grid-template-columns: minmax(200px, 250px) minmax(0, 1fr);
    align-items: start;
  }

  .sidebar {
    position: sticky;
    top: calc(68px + var(--space-5));
    max-height: calc(100vh - 68px - var(--space-8));
    overflow-y: auto;
  }

  .group + .group {
    margin-top: var(--space-6);
  }

  .group-title {
    margin: 0 0 var(--space-3);
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .sidebar ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .side-link:hover {
    background: var(--surface);
    color: var(--ink);
  }

  .side-link.current {
    background: var(--surface-soft);
    color: var(--ink);
    font-weight: 650;
  }

  .badge {
    padding: 1px 7px;
    border-radius: var(--radius-pill);
    background: var(--danger-soft);
    color: var(--pill-warn-ink);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 700;
  }

  /*
   * Prose stays at a readable measure, but tables and code blocks are allowed
   * the full width of the column — installation docs carry wide comparison
   * tables and long command lines that a 780px measure would clip.
   */
  .doc-body {
    min-width: 0;
    max-width: 100%;
  }

  .doc-body > :global(:not(table):not(pre)) {
    max-width: var(--width-prose);
  }

  .doc-body :global(table) {
    width: 100%;
  }

  .doc-head {
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--line);
  }

  .doc-head h1 {
    font-size: var(--text-3xl);
  }

  .doc-head .lede {
    margin-bottom: 0;
  }

  /* Markdown rhythm. */
  .doc-body :global(h2) {
    margin-top: var(--space-8);
    padding-top: var(--space-2);
    font-size: var(--text-2xl);
    scroll-margin-top: 90px;
  }

  .doc-body :global(h3) {
    margin-top: var(--space-6);
    scroll-margin-top: 90px;
  }

  .doc-body :global(ul),
  .doc-body :global(ol) {
    margin: 0 0 var(--space-4);
    padding-inline-start: 1.35em;
  }

  .doc-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .doc-body :global(pre) {
    margin-bottom: var(--space-5);
  }

  .doc-body :global(table) {
    display: block;
    overflow-x: auto;
    margin-bottom: var(--space-5);
  }

  .doc-body :global(blockquote) {
    margin: 0 0 var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--line-strong);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--surface);
    color: var(--ink-soft);
  }

  .doc-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }

    .sidebar {
      position: static;
      max-height: none;
      padding-bottom: var(--space-6);
      border-bottom: 1px solid var(--line);
    }
  }
</style>
